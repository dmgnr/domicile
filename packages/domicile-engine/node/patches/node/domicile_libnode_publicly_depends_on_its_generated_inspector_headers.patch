From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 22 Nov 2026 00:00:00 +0000
Subject: [PATCH] domicile: libnode publicly depends on its generated inspector
 headers

Chromium's GN now checks that a target's public headers come from its
public dependencies. libnode lists the inspector protocol headers that
node_protocol_generated_sources generates among its sources, and `gn gen`
refused it: "Input to target not generated by a dependency".
---
 unofficial.gni | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/unofficial.gni b/unofficial.gni
index 3736a5b..afbbfce 100644
--- a/unofficial.gni
+++ b/unofficial.gni
@@ -282,9 +282,12 @@ template("node_gn_build") {
     if (node_enable_inspector) {
       deps += [
         "$node_inspector_protocol_path:crdtp",
-        "src/inspector:node_protocol_generated_sources",
         "src/inspector:v8_inspector_compress_protocol_json",
       ]
+
+      # The generated protocol headers are among libnode's sources, so GN's
+      # strict include check wants their generator as a public dependency.
+      public_deps += [ "src/inspector:node_protocol_generated_sources" ]
       include_dirs = [
         "$target_gen_dir/src",
         "$target_gen_dir/src/inspector",
