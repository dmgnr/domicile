From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 17:00:00 +0000
Subject: [PATCH] domicile: a webview lists its history for back and forward
 menus

`<webview>.history()` answers the pages either side of the current one,
for a shell's back and forward menus like Chrome's.

- Blink build lists: the DomicileHistory and DomicileHistoryEntry
  dictionaries it answers with.

Verified: not built. This repository cannot build Chromium; the engine
job builds it on `crux`.
---
 third_party/blink/renderer/bindings/generated_in_core.gni | 4 ++++
 third_party/blink/renderer/bindings/idl_in_core.gni       | 2 ++
 2 files changed, 6 insertions(+)

diff --git a/third_party/blink/renderer/bindings/generated_in_core.gni b/third_party/blink/renderer/bindings/generated_in_core.gni
index d53dcfb..b569b09 100644
--- a/third_party/blink/renderer/bindings/generated_in_core.gni
+++ b/third_party/blink/renderer/bindings/generated_in_core.gni
@@ -210,6 +210,10 @@ generated_dictionary_sources_in_core = [
   "$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_dom_rect_init.h",
   "$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_domicile_device.cc",
   "$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_domicile_device.h",
+  "$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_domicile_history.cc",
+  "$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_domicile_history.h",
+  "$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_domicile_history_entry.cc",
+  "$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_domicile_history_entry.h",
   "$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_domicile_identity_account.cc",
   "$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_domicile_identity_account.h",
   "$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_domicile_identity_provider.cc",
diff --git a/third_party/blink/renderer/bindings/idl_in_core.gni b/third_party/blink/renderer/bindings/idl_in_core.gni
index 7adffde..91cd59f 100644
--- a/third_party/blink/renderer/bindings/idl_in_core.gni
+++ b/third_party/blink/renderer/bindings/idl_in_core.gni
@@ -478,6 +478,8 @@ static_idl_files_in_core = [
   "//third_party/blink/renderer/core/html/domicile/domicile_identity_account.idl",
   "//third_party/blink/renderer/core/html/domicile/domicile_identity_event.idl",
   "//third_party/blink/renderer/core/html/domicile/domicile_identity_provider.idl",
+  "//third_party/blink/renderer/core/html/domicile/domicile_history.idl",
+  "//third_party/blink/renderer/core/html/domicile/domicile_history_entry.idl",
   "//third_party/blink/renderer/core/html/html_geolocation_element.idl",
   "//third_party/blink/renderer/core/html/html_head_element.idl",
   "//third_party/blink/renderer/core/html/html_heading_element.idl",
