From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Connor Prussin <connor@prussin.net>
Date: Tue, 24 Nov 2026 00:00:00 +0000
Subject: [PATCH] domicile: an Electron app hears its pages preconnect

A page's resource hint fires its Electron session's preconnect, with the
URL and whether credentials go along. NetworkHintsHandlerImpl tells
chrome/browser/domicile/domicile_electron_preconnect.h of each hint before
it preconnects as for any page.
---
 chrome/browser/predictors/network_hints_handler_impl.cc | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/chrome/browser/predictors/network_hints_handler_impl.cc b/chrome/browser/predictors/network_hints_handler_impl.cc
index fd78d2d..49411b2 100644
--- a/chrome/browser/predictors/network_hints_handler_impl.cc
+++ b/chrome/browser/predictors/network_hints_handler_impl.cc
@@ -7,6 +7,7 @@
 #include <optional>
 
 #include "base/memory/ptr_util.h"
+#include "chrome/browser/domicile/domicile_electron_preconnect.h"
 #include "chrome/browser/predictors/loading_predictor.h"
 #include "chrome/browser/predictors/loading_predictor_factory.h"
 #include "chrome/browser/profiles/profile.h"
@@ -116,6 +117,10 @@ void NetworkHintsHandlerImpl::PrefetchDNS(
 
 void NetworkHintsHandlerImpl::Preconnect(const url::SchemeHostPort& url,
                                          bool allow_credentials) {
+  // Domicile: an Electron app's page tells its session's `preconnect`. See
+  // chrome/browser/domicile/domicile_electron_preconnect.h.
+  domicile::TellElectronAppOfPreconnect(render_frame_host_id_, url.GetURL(),
+                                        allow_credentials);
   if (!preconnect_manager_)
     return;
 
