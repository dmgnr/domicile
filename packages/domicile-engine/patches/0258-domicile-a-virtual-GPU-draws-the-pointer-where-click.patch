+// DOMICILE: a virtual GPU (vmwgfx, virtio-gpu, qxl) hands the cursor image to
+// its host, which draws it at the host's pointer by its hotspot. Each CRTC is
+// told the hotspot, or the arrow's tip is drawn away from where clicks land.
+using DrmCursorHotspotTest = DrmWindowTest;
+
+TEST_F(DrmCursorHotspotTest, TheCrtcIsToldWhereThePointerIsInTheImage) {
+  screen_manager_->GetWindow(kDefaultWidgetHandle)
+      ->SetCursor(std::vector<SkBitmap>(1, AllocateBitmap(gfx::Size(24, 24))),
+                  gfx::Point(6, 4), gfx::Point(94, 96), base::TimeDelta());
+
+  EXPECT_EQ(gfx::Point(6, 4), drm_->get_crtc_cursor_hotspot(crtc_id_));
+  // Still the image's top left: the host takes the hotspot off, not us.
+  EXPECT_EQ(gfx::Point(94, 96), drm_->get_crtc_cursor_location(crtc_id_));
+}
+
+TEST_F(DrmCursorHotspotTest, TheHotspotFollowsTheWindowOntoAnotherDevice) {
+  screen_manager_->GetWindow(kDefaultWidgetHandle)
+      ->SetCursor(std::vector<SkBitmap>(1, AllocateBitmap(gfx::Size(24, 24))),
+                  gfx::Point(6, 4), gfx::Point(94, 96), base::TimeDelta());
+
+  InitializeDrmState(drm2_.get());
+  screen_manager_->AddDisplayController(drm2_, crtc_id_, connector_id_);
+  std::vector<ControllerConfigParams> controllers_to_enable;
+  controllers_to_enable.emplace_back(
+      /*display_id=*/2, drm2_, crtc_id_, connector_id_,
+      gfx::Point(0, kDefaultMode.vdisplay),
+      std::make_unique<drmModeModeInfo>(kDefaultMode));
+  screen_manager_->ConfigureDisplayControllers(
+      controllers_to_enable, {display::ModesetFlag::kTestModeset,
+                              display::ModesetFlag::kCommitModeset});
+  screen_manager_->GetWindow(kDefaultWidgetHandle)
+      ->SetBounds(gfx::Rect(0, kDefaultMode.vdisplay, kDefaultMode.hdisplay,
+                            kDefaultMode.vdisplay));
+
+  EXPECT_NE(0u, drm2_->get_cursor_handle_for_crtc(crtc_id_));
+  EXPECT_EQ(gfx::Point(6, 4), drm2_->get_crtc_cursor_hotspot(crtc_id_));
+}
