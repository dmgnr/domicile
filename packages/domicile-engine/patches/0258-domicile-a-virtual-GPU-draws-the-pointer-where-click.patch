                            uint32_t handle,
-                           const gfx::Size& size) {
+                           const gfx::Size& size,
+                           const gfx::Point& hotspot) {
   CHECK(drm_fd_.is_valid(), base::NotFatalUntil::M163);
   TRACE_EVENT2("drm", "DrmWrapper::SetCursor", "crtc_id", crtc_id, "handle",
