From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 20 Nov 2026 00:00:00 +0000
Subject: [PATCH] domicile: set-log-level reaches every engine process

`domicile set-log-level` changes the engine's minimum severity and
`--vmodule` while it runs. A level is per process, so each child process
gets it over `mojom::ChildProcess::SetLogLevels`, and one started later
gets the last levels as it starts. `logging::SetVmodule` replaces the
VLOG patterns, leaking the old ones as `--vmodule` does in tests.
---
 base/logging.cc                                          | 9 +++++++++
 base/logging.h                                           | 4 ++++
 content/browser/BUILD.gn                                 | 2 ++
 content/browser/child_process_host_impl.cc               | 2 ++
 .../browser/renderer_host/render_process_host_impl.cc    | 7 +++++++
 content/browser/renderer_host/render_process_host_impl.h | 2 ++
 content/child/child_thread_impl.cc                       | 7 +++++++
 content/common/child_process.mojom                       | 4 ++++
 content/public/browser/BUILD.gn                          | 1 +
 9 files changed, 38 insertions(+)

diff --git a/base/logging.cc b/base/logging.cc
index e2506e2..a4c2d2b 100644
--- a/base/logging.cc
+++ b/base/logging.cc
@@ -556,6 +556,15 @@ int GetMinLogLevel() {
   return g_min_log_level;
 }
 
+void SetVmodule(std::string_view vmodule_switch) {
+#if defined(LEAK_SANITIZER)
+  // See comments on |g_vlog_info|: the replaced one may still be read.
+  ScopedLeakSanitizerDisabler lsan_disabler;
+#endif  // defined(LEAK_SANITIZER)
+  ExchangeVlogInfo(new VlogInfo(/*v_switch=*/"", vmodule_switch,
+                                g_min_log_level));
+}
+
 uint32_t GetLoggingDestination() {
   return g_logging_destination;
 }
diff --git a/base/logging.h b/base/logging.h
index 26bed11..829fdd3 100644
--- a/base/logging.h
+++ b/base/logging.h
@@ -231,6 +231,10 @@ BASE_EXPORT void SetMinLogLevel(int level);
 // Gets the current log level.
 BASE_EXPORT int GetMinLogLevel();
 
+// Domicile: replaces this process's `--vmodule` patterns, for `domicile
+// set-log-level`. The default VLOG level stays the one SetMinLogLevel sets.
+BASE_EXPORT void SetVmodule(std::string_view vmodule_switch);
+
 // Used by LOG_IS_ON to lazy-evaluate stream arguments.
 BASE_EXPORT bool ShouldCreateLogMessage(int severity);
 
