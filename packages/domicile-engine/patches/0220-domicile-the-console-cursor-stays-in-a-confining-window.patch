diff --git a/ui/ozone/platform/drm/host/drm_cursor.cc b/ui/ozone/platform/drm/host/drm_cursor.cc
index a26dce1..278a7ef 100644
--- a/ui/ozone/platform/drm/host/drm_cursor.cc
+++ b/ui/ozone/platform/drm/host/drm_cursor.cc
@@ -129,6 +129,11 @@ void DrmCursor::OnWindowRemoved(gfx::AcceleratedWidget window) {
   std::erase_if(screens_, [window](const PointerScreen& screen) {
     return screen.window == window;
   });
+  // DOMICILE: a confinement to a window that is gone holds nothing; the shell
+  // confines the pointer again on the window that replaces it.
+  if (confinement_.window == window) {
+    confinement_ = PointerConfinement();
+  }
 
   if (window_ == window) {
     // Try to find a new location for the cursor.
@@ -212,6 +217,16 @@ void DrmCursor::SetDomicileAbsoluteAreas(
   absolute_areas_ = std::move(areas);
 }
 
+void DrmCursor::SetDomicileConfinement(PointerConfinement confinement) {
+  DCHECK_CALLED_ON_VALID_THREAD(ui_thread_checker_);
+  base::AutoLock lock(lock_);
+  CHECK(confinement.boxes.empty() ||
+        std::ranges::find(screens_, confinement.window,
+                          &PointerScreen::window) != screens_.end())
+      << "domicile: the pointer confined to a window it cannot be on";
+  confinement_ = std::move(confinement);
+}
+
 void DrmCursor::MoveCursorTo(gfx::AcceleratedWidget window,
                              const gfx::PointF& location) {
   TRACE_EVENT0("drmcursor", "DrmCursor::MoveCursorTo (window)");
@@ -284,6 +299,19 @@ void DrmCursor::MoveCursorToOnEvdevThread(const gfx::PointF& screen_location) {
   // it would stop at the edge.
   const std::optional<PointerHeard> under = PointerHeardAt(
       screens_, layout_, gfx::kNullAcceleratedWidget, screen_location);
+  // DOMICILE: a confined pointer stops at its box, a tablet's as a mouse's.
+  // See `ConfinedMove`.
+  if (const std::optional<PointerCrossing> held = ConfinedMove(
+          screens_, layout_, confinement_, {window_, location_},
+          under.has_value()
+              ? PointerCrossing{under->window, under->location}
+              : PointerCrossing{
+                    window_,
+                    screen_location -
+                        display_bounds_in_screen_.OffsetFromOrigin()})) {
+    MoveLocked(*held);
+    return;
+  }
   if (under.has_value() && under->window != window_) {
     CrossLocked({under->window, under->location});
     return;
@@ -322,6 +350,14 @@ void DrmCursor::MoveCursor(const gfx::Vector2dF& delta) {
   const gfx::PointF moved = location_ + transformed_delta;
   const std::optional<PointerCrossing> crossing =
       PointerCrossingFor(screens_, layout_, window_, moved);
+  // DOMICILE: a confined pointer stops at its box, which may reach across a
+  // seam. See `ConfinedMove`.
+  if (const std::optional<PointerCrossing> held =
+          ConfinedMove(screens_, layout_, confinement_, {window_, location_},
+                       crossing.value_or(PointerCrossing{window_, moved}))) {
+    MoveLocked(*held);
+    return;
+  }
   if (crossing.has_value()) {
     CrossLocked(*crossing);
   } else {
@@ -392,6 +428,17 @@ void DrmCursor::CrossLocked(const PointerCrossing& crossing)
   SendCursorShowLocked();
 }
 
+// Onto `to`, a crossing or a move within the window the pointer is on.
+void DrmCursor::MoveLocked(const PointerCrossing& to)
+    EXCLUSIVE_LOCKS_REQUIRED(lock_) {
+  if (to.window != window_) {
+    CrossLocked(to);
+    return;
+  }
+  SetCursorLocationLocked(to.location);
+  SendCursorMoveLocked();
+}
+
 void DrmCursor::SendCursorShowLocked() EXCLUSIVE_LOCKS_REQUIRED(lock_) {
   SetDeskCursorImageLocked();
 
