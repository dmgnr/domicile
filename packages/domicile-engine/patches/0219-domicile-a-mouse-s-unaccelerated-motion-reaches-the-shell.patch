diff --git a/third_party/blink/common/input/web_coalesced_input_event_mojom_traits.cc b/third_party/blink/common/input/web_coalesced_input_event_mojom_traits.cc
index 70feec3..a6080f7 100644
--- a/third_party/blink/common/input/web_coalesced_input_event_mojom_traits.cc
+++ b/third_party/blink/common/input/web_coalesced_input_event_mojom_traits.cc
@@ -60,8 +60,9 @@ blink::mojom::PointerDataPtr PointerDataFromPointerProperties(
       pointer.id, pointer.force, pointer.tilt_x, pointer.tilt_y,
       pointer.tangential_pressure, pointer.twist, pointer.button,
       pointer.pointer_type, pointer.movement_x, pointer.movement_y,
-      pointer.is_raw_movement_event, pointer.PositionInWidget(),
-      pointer.PositionInScreen(), std::move(mouse_data), pointer.device_id);
+      pointer.is_raw_movement_event, pointer.unaccelerated_movement,
+      pointer.PositionInWidget(), pointer.PositionInScreen(),
+      std::move(mouse_data), pointer.device_id);
 }
 
 void PointerPropertiesFromPointerData(
@@ -79,6 +80,8 @@ void PointerPropertiesFromPointerData(
   pointer_properties->movement_y = pointer_data->movement_y;
   pointer_properties->is_raw_movement_event =
       pointer_data->is_raw_movement_event;
+  pointer_properties->unaccelerated_movement =
+      pointer_data->unaccelerated_movement;
   pointer_properties->device_id = pointer_data->device_id;
   pointer_properties->SetPositionInWidget(pointer_data->widget_position);
   pointer_properties->SetPositionInScreen(pointer_data->screen_position);
diff --git a/third_party/blink/common/input/web_mouse_event.cc b/third_party/blink/common/input/web_mouse_event.cc
index 36b74df..24b38ad 100644
--- a/third_party/blink/common/input/web_mouse_event.cc
+++ b/third_party/blink/common/input/web_mouse_event.cc
@@ -59,9 +59,17 @@ void WebMouseEvent::Coalesce(const WebInputEvent& event) {
   // Accumulate movement deltas.
   int x = movement_x;
   int y = movement_y;
+  // DOMICILE: and the unaccelerated ones. Dropped when either move has none,
+  // since half a sum is no motion at all.
+  const std::optional<gfx::Vector2dF> unaccelerated = unaccelerated_movement;
   *this = mouse_event;
   movement_x += x;
   movement_y += y;
+  if (unaccelerated && unaccelerated_movement) {
+    *unaccelerated_movement += *unaccelerated;
+  } else {
+    unaccelerated_movement.reset();
+  }
 }
 
 WebMouseEvent WebMouseEvent::FlattenTransform() const {
