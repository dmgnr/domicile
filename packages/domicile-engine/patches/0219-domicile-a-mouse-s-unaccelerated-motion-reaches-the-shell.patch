 #include "third_party/blink/public/mojom/input/input_event.mojom-shared.h"
 #include "ui/events/event_constants.h"
 #include "ui/gfx/geometry/point_f.h"
+#include "ui/gfx/geometry/vector2d_f.h"
 
 #include <limits>
+#include <optional>
 
 namespace blink {
 
@@ -109,6 +111,12 @@ class WebPointerProperties {
   // TODO(crbug.com/982379): Figure out how to avoid using this boolean.
   bool is_raw_movement_event = false;
 
+  // DOMICILE: how far the device moved before pointer acceleration, in
+  // physical pixels, when it said: a game's unaccelerated relative motion.
+  // `movement_x/y` stays the accelerated motion the page sees. Summed when
+  // moves coalesce. See ui/events/domicile/unaccelerated_motion.h.
+  std::optional<gfx::Vector2dF> unaccelerated_movement;
+
   // Contains unique device id for pen on supported devices.
   int32_t device_id = -1;
 
diff --git a/third_party/blink/public/mojom/input/input_handler.mojom b/third_party/blink/public/mojom/input/input_handler.mojom
index 8c8d550..0d4e067 100644
--- a/third_party/blink/public/mojom/input/input_handler.mojom
+++ b/third_party/blink/public/mojom/input/input_handler.mojom
@@ -67,6 +67,8 @@ struct PointerData {
   int32 movement_x;
   int32 movement_y;
   bool is_raw_movement_event;
+  // DOMICILE: WebPointerProperties::unaccelerated_movement.
+  gfx.mojom.Vector2dF? unaccelerated_movement;
   gfx.mojom.PointF widget_position;
   gfx.mojom.PointF screen_position;
