 #ifndef THIRD_PARTY_BLINK_RENDERER_CORE_EVENTS_POINTER_EVENT_H_
 #define THIRD_PARTY_BLINK_RENDERER_CORE_EVENTS_POINTER_EVENT_H_
 
+#include <optional>
+
 #include "third_party/blink/public/common/input/pointer_id.h"
 #include "third_party/blink/renderer/core/core_export.h"
 #include "third_party/blink/renderer/core/events/mouse_event.h"
 #include "third_party/blink/renderer/platform/wtf/casting.h"
+#include "ui/gfx/geometry/vector2d_f.h"
 
 namespace blink {
 
@@ -134,6 +137,17 @@ class CORE_EXPORT PointerEvent : public MouseEvent {
     return prevent_counting_as_interaction_;
   }
 
+  // DOMICILE: the device's motion before pointer acceleration, in physical
+  // pixels, for a move whose device said. Not exposed to script: an <app>
+  // forwards it to its client's relative pointer. See
+  // WebPointerProperties::unaccelerated_movement.
+  const std::optional<gfx::Vector2dF>& UnacceleratedMovement() const {
+    return unaccelerated_movement_;
+  }
+  void SetUnacceleratedMovement(const std::optional<gfx::Vector2dF>& movement) {
+    unaccelerated_movement_ = movement;
+  }
+
   void Trace(Visitor*) const override;
 
  private:
@@ -160,6 +174,8 @@ class CORE_EXPORT PointerEvent : public MouseEvent {
 
   // See equivalent member in web_input_event.h.
   bool prevent_counting_as_interaction_ = false;
+
+  std::optional<gfx::Vector2dF> unaccelerated_movement_;
 };
 
