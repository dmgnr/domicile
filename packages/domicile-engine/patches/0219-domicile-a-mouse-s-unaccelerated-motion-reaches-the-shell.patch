@@ -314,6 +315,11 @@ void EventFactoryEvdev::DispatchMouseMoveEvent(
   event.set_location_f(location);
   event.set_root_location_f(location);
   event.set_source_device_id(params.device_id);
+  // DOMICILE: the ordinal delta is the device's motion before acceleration,
+  // which a game's relative pointer reads. Off ChromeOS nothing else sets it.
