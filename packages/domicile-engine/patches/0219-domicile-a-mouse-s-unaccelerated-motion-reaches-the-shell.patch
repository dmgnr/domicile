--- a/ui/events/ozone/evdev/libinput_event_converter.cc
+++ b/ui/events/ozone/evdev/libinput_event_converter.cc
@@ -469,8 +469,14 @@ void LibInputEventConverter::HandlePointerMotion(const LibInputEvent& evt) {
 
   DVLOG(3) << "Pointer motion: dx=" << dx << ", dy=" << dy;
 
+  // DOMICILE: the device's own motion, before libinput accelerated it, rides
+  // along as the ordinal delta: a game reads it as zwp_relative_pointer_v1's
+  // unaccelerated deltas. See ui/events/domicile/unaccelerated_motion.h.
+  gfx::Vector2dF unaccelerated(
+      libinput_event_pointer_get_dx_unaccelerated(event),
+      libinput_event_pointer_get_dy_unaccelerated(event));
   dispatcher_->DispatchMouseMoveEvent(
-      {input_device_.id, flags, cursor_->GetLocation(), nullptr /*delta*/,
+      {input_device_.id, flags, cursor_->GetLocation(), &unaccelerated,
        PointerDetails(EventPointerType::kMouse), Timestamp(evt)});
 }
 
