   // Accumulate movement deltas.
   int x = movement_x;
   int y = movement_y;
+  // DOMICILE: and the unaccelerated ones. Dropped when either move has none,
+  // since half a sum is no motion at all.
+  const std::optional<gfx::Vector2dF> unaccelerated = unaccelerated_movement;
   *this = pointer_event;
   movement_x += x;
   movement_y += y;
+  if (unaccelerated && unaccelerated_movement) {
+    *unaccelerated_movement += *unaccelerated;
+  } else {
+    unaccelerated_movement.reset();
+  }
 }
 
