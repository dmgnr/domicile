 content/public/browser/content_browser_client.cc    |  6 ++++++
 content/public/browser/content_browser_client.h     |  9 +++++++++
 5 files changed, 38 insertions(+)

diff --git a/chrome/browser/chrome_content_browser_client.cc b/chrome/browser/chrome_content_browser_client.cc
index e313249..a893213 100644
--- a/chrome/browser/chrome_content_browser_client.cc
+++ b/chrome/browser/chrome_content_browser_client.cc
@@ -8,6 +8,7 @@
 #include "chrome/browser/domicile/domicile_identity_dialog.h"
 #include "chrome/browser/domicile/domicile_picture_in_picture.h"
 #include "components/domicile/browser/force_dark.h"
+#include "components/domicile/browser/shell_origin.h"
 #include "components/domicile/browser/shell_source.h"
 #include "components/domicile/browser/shell_url_loader_factory.h"
 #include "components/domicile/common/domicile_scheme.h"
@@ -6503,6 +6504,15 @@ bool ChromeContentBrowserClient::MayGuestLoadUnsafeScheme(
   return domicile::MayElectronPageLoad(guest, url);
 }
 
+bool ChromeContentBrowserClient::IsCrossOriginIsolatedByEmbedder(
+    content::BrowserContext* browser_context,
+    const url::Origin& origin) {
+  // Domicile's engine fork. The shell and app modules run with the desktop's
+  // trust, so they get shared memory without COOP and COEP. See
+  // docs/architecture/DOMICILE-SCHEME.md.
+  return domicile::IsCrossOriginIsolatedOrigin(origin);
+}
