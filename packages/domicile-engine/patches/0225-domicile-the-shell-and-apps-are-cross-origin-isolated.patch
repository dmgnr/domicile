   // schemes only (see NavigationControllerImpl). By default, false.
   virtual bool MayGuestLoadUnsafeScheme(WebContents* guest, const GURL& url);
 
+  // Domicile's engine fork. Whether a document on `origin` is cross-origin
+  // isolated with no Cross-Origin-Opener-Policy, Cross-Origin-Embedder-Policy
