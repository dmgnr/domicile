 void CompositorFrameSinkSupport::SetNeedsBeginFrame(bool needs_begin_frame) {
+  if (needs_begin_frame && !client_needs_begin_frame_) {
+    domicile_wanted_since_ = base::TimeTicks::Now();
+    domicile_offered_since_sent_ = 0;
+    DomicileArmStarvedCheck(kDomicileStarvedAfter);
+  } else if (!needs_begin_frame) {
+    domicile_starved_timer_.Stop();
+    domicile_reported_starved_ = false;
+  }
   client_needs_begin_frame_ = needs_begin_frame;
   UpdateNeedsBeginFramesInternal();
 }
 
+void CompositorFrameSinkSupport::DomicileArmStarvedCheck(
+    base::TimeDelta delay) {
+  domicile_starved_timer_.Start(
+      FROM_HERE, delay,
+      base::BindOnce(&CompositorFrameSinkSupport::DomicileCheckStarved,
+                     base::Unretained(this)));
+}
+
+void CompositorFrameSinkSupport::DomicileCheckStarved() {
+  if (!client_needs_begin_frame_) {
+    return;
+  }
+  const base::TimeTicks now = base::TimeTicks::Now();
+  const base::TimeTicks since =
+      std::max(domicile_wanted_since_, domicile_last_sent_);
+  if (now - since < kDomicileStarvedAfter) {
+    DomicileArmStarvedCheck(kDomicileStarvedAfter - (now - since));
+    return;
+  }
+  if (!domicile_reported_starved_) {
+    domicile_reported_starved_ = true;
+    std::string last_sent = "never";
+    if (!domicile_last_sent_.is_null()) {
+      last_sent = last_begin_frame_args_.ToString() + ", " +
+                  base::NumberToString((now - domicile_last_sent_).InSecondsF()) +
+                  " s ago";
+    }
+    LOG(ERROR) << "domicile: frame sink " << frame_sink_id_.ToString()
+               << " has wanted begin frames for "
+               << (now - domicile_wanted_since_).InSecondsF()
+               << " s and got none for " << (now - since).InSecondsF()
+               << " s: begin frame source "
+               << (begin_frame_source_ ? "set" : "none") << " (paused "
+               << (domicile_source_paused_ ? "yes" : "no") << "), observing it "
+               << (added_frame_observer_ ? "yes" : "no") << ", bundled "
+               << (bundle_id_.has_value() ? "yes" : "no")
+               << ", needs begin frame " << (needs_begin_frame_ ? "yes" : "no")
+               << ", offered " << domicile_offered_since_sent_
+               << " since the last sent (last decision: "
+               << domicile_last_decision_ << "), unanswered "
+               << (begin_frame_tracker_.ShouldStopBeginFrame()
+                       ? "at the stop limit"
+                       : (begin_frame_tracker_.ShouldThrottleBeginFrame()
+                              ? "at the throttle limit"
+                              : "below the limits"))
+               << ", pending frames " << pending_frames_
+               << ", active surface " << last_activated_surface_id_.ToString()
+               << ", client " << (client_ ? "bound" : "none")
+               << ", last sent " << last_sent << ".";
+  }
+  DomicileArmStarvedCheck(kDomicileStarvedAfter);
+}
