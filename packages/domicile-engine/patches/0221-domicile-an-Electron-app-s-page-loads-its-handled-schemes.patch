@@ -332,8 +333,13 @@ std::optional<NavigationNotStartedReason> CheckURLForNavigationError(
           ->GetSecurityPrincipal()
           .IsGuest()) {
     auto* cpsp = content::ChildProcessSecurityPolicy::GetInstance();
+    // Domicile's engine fork: unless the embedder lets this guest load the
+    // scheme (an Electron app window loading the app's own files).
     if (!cpsp->IsWebSafeScheme(dest_url.GetScheme()) &&
-        !dest_url.SchemeIs(url::kAboutScheme)) {
+        !dest_url.SchemeIs(url::kAboutScheme) &&
+        !GetContentClient()->browser()->MayGuestLoadUnsafeScheme(
+            WebContents::FromRenderFrameHost(node->current_frame_host()),
+            dest_url)) {
       LOG(WARNING) << "Refusing to load unsafe URL in a guest: "
                    << dest_url.possibly_invalid_spec();
       return NavigationNotStartedReason::kDisallowedScheme;
