 #include "chrome/browser/domicile/domicile_picture_in_picture.h"
 #include "components/domicile/browser/force_dark.h"
@@ -6483,6 +6484,14 @@ base::FilePath DomicileShellRoot() {
 
 }  // namespace
 
+bool ChromeContentBrowserClient::MayGuestLoadUnsafeScheme(
+    content::WebContents* guest,
+    const GURL& url) {
+  // Domicile's engine fork. An Electron app window is a guest, and loads
+  // file: and the app's own schemes once its session handles them.
+  return domicile::MayElectronPageLoad(guest, url);
+}
+
 mojo::PendingRemote<network::mojom::URLLoaderFactory>
 ChromeContentBrowserClient::CreateNonNetworkNavigationURLLoaderFactory(
     const std::string& scheme,
@@ -6496,6 +6505,14 @@ ChromeContentBrowserClient::CreateNonNetworkNavigationURLLoaderFactory(
     return domicile::ShellURLLoaderFactory::Create(DomicileShellRoot());
   }
 
+  // Domicile's engine fork. An Electron app window's page loads file: and
+  // the app's own schemes from the app, when its session handles them.
+  if (mojo::PendingRemote<network::mojom::URLLoaderFactory> electron =
+          domicile::ElectronNavigationLoaderFactory(scheme,
+                                                    frame_tree_node_id)) {
+    return electron;
+  }
+
 #if BUILDFLAG(ENABLE_EXTENSIONS_CORE) || BUILDFLAG(IS_CHROMEOS) || \
     !BUILDFLAG(IS_ANDROID)
   content::WebContents* web_contents =
@@ -6911,6 +6928,10 @@ void ChromeContentBrowserClient::
   factories->emplace(
       domicile::kDomicileScheme,
       domicile::ShellURLLoaderFactory::Create(DomicileShellRoot()));
+  // And an Electron app window's page loads file: and the app's own schemes
+  // from the app. Its file: loader replaces content's, which reads any file.
+  domicile::AddElectronSubresourceLoaderFactories(render_process_id,
+                                                  render_frame_id, factories);
 
 #if BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(ENABLE_EXTENSIONS_CORE) || \
     !BUILDFLAG(IS_ANDROID)
@@ -7031,6 +7052,11 @@ void ChromeContentBrowserClient::WillCreateURLLoaderFactory(
     network::mojom::URLLoaderFactoryOverridePtr* factory_override,
     scoped_refptr<base::SequencedTaskRunner> navigation_response_task_runner,
     bool is_for_network_service) {
+  // Domicile's engine fork. First, so an Electron app's protocol.handle
+  // for http or https answers its page's request before anything else sees
+  // it, as in Electron.
+  domicile::ProxyElectronNetworkLoads(frame, factory_builder);
+
 #if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
   auto* web_request_api =
       extensions::BrowserContextKeyedAPIFactory<extensions::WebRequestAPI>::Get(
