diff --git a/chrome/browser/chrome_content_browser_client.cc b/chrome/browser/chrome_content_browser_client.cc
index 27f9c93..983f7f7 100644
--- a/chrome/browser/chrome_content_browser_client.cc
+++ b/chrome/browser/chrome_content_browser_client.cc
@@ -5,6 +5,7 @@
 #include "chrome/browser/chrome_content_browser_client.h"
 
 #include "chrome/browser/domicile/domicile_electron_loader.h"
+#include "chrome/browser/domicile/domicile_electron_page.h"
 #include "chrome/browser/domicile/domicile_identity_dialog.h"
 #include "chrome/browser/domicile/domicile_picture_in_picture.h"
 #include "components/domicile/browser/force_dark.h"
@@ -2069,6 +2070,13 @@ bool ChromeContentBrowserClient::ShouldUseSpareRenderProcessHost(
     const GURL& site_url,
     std::optional<SpareProcessRefusedByEmbedderReason>& refused_reason) {
   refused_reason = std::nullopt;
+  // Domicile's engine fork. An Electron page with Node.js starts a renderer
+  // of its own: the spare started sandboxed. See
+  // chrome/browser/domicile/domicile_electron_page.h.
+  if (domicile::ElectronPage::RefusesSpareRenderer(site_url)) {
+    refused_reason = SpareProcessRefusedByEmbedderReason::DefaultDisabled;
+    return false;
+  }
   Profile* profile = Profile::FromBrowserContext(browser_context);
   if (!profile) {
     refused_reason = SpareProcessRefusedByEmbedderReason::NoProfile;
@@ -2473,6 +2481,12 @@ bool ChromeContentBrowserClient::ShouldStayInParentProcessForNTP(
 bool ChromeContentBrowserClient::IsSuitableHost(
     content::RenderProcessHost* process_host,
     const content::SecurityPrincipal& security_principal) {
+  // Domicile's engine fork: an Electron page with Node.js gets a renderer of
+  // its own. See chrome/browser/domicile/domicile_electron_page.h.
+  if (!domicile::ElectronPage::IsSuitableHost(
+          *process_host, security_principal.GetDeprecatedSiteURL())) {
+    return false;
+  }
   Profile* profile =
       Profile::FromBrowserContext(process_host->GetBrowserContext());
   // This may be nullptr during tests. In that case, just assume any site can
@@ -2529,6 +2543,13 @@ bool ChromeContentBrowserClient::MayReuseHost(
     return false;
   }
 
+  // Domicile's engine fork. A renderer for an Electron page with Node.js is
+  // that page's alone: it is unsandboxed. See
+  // chrome/browser/domicile/domicile_electron_page.h.
+  if (domicile::ElectronPage::IsForNode(*process_host)) {
+    return false;
+  }
+
   return true;
 }
 
@@ -2591,9 +2612,19 @@ class NTPUserData : public base::SupportsUserData::Data {
 
 }  // namespace
 
+void ChromeContentBrowserClient::MainFrameNavigatesInto(
+    content::RenderFrameHost* main_frame,
+    SiteInstance* site_instance) {
+  domicile::ElectronPage::MainFrameNavigatesInto(*main_frame, *site_instance);
+}
+
 void ChromeContentBrowserClient::SiteInstanceGotProcessAndSite(
     SiteInstance* site_instance) {
   CHECK(site_instance->HasProcess());
+  // Domicile's engine fork: an Electron page with Node.js marks the renderer
+  // its navigation got, before it starts. See
+  // chrome/browser/domicile/domicile_electron_page.h.
+  domicile::ElectronPage::SiteInstanceGotProcess(*site_instance);
 
   Profile* profile =
       Profile::FromBrowserContext(site_instance->GetBrowserContext());
@@ -3186,6 +3217,10 @@ void ChromeContentBrowserClient::AppendExtraCommandLineSwitches(
       for (auto& part : extra_parts_) {
         part->AppendExtraRendererCommandLineSwitches(command_line, *process);
       }
+      // Domicile's engine fork: a renderer for an Electron page with Node.js
+      // starts as Electron starts it. See
+      // chrome/browser/domicile/domicile_electron_page.h.
+      domicile::ElectronPage::AppendRendererSwitches(*process, *command_line);
     }
 
