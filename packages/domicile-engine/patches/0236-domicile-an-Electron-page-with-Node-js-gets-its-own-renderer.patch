diff --git a/content/browser/child_process_launcher_helper_linux.cc b/content/browser/child_process_launcher_helper_linux.cc
index 84c3f31..1b3f7f8 100644
--- a/content/browser/child_process_launcher_helper_linux.cc
+++ b/content/browser/child_process_launcher_helper_linux.cc
@@ -66,6 +66,19 @@ bool ChildProcessLauncherHelper::BeforeLaunchOnLauncherThread(
       options->fds_to_remap.emplace_back(sandbox_fd, GetSandboxFD());
     }
 
+    // Domicile's engine fork, as Electron's
+    // allow_new_privileges_in_unsandboxed_child_processes.patch: a child
+    // launched without the zygote while the zygote is in use is unsandboxed,
+    // the renderer of an Electron page with Node.js, and may start setuid
+    // programs, as Node's child_process does in Electron.
+    if (GetProcessType() == switches::kRendererProcess &&
+        command_line()->HasSwitch(switches::kNoZygote) &&
+        !base::CommandLine::ForCurrentProcess()->HasSwitch(
+            switches::kNoZygote) &&
+        delegate_->GetZygote() == nullptr) {
+      options->allow_new_privs = true;
+    }
+
     options->environment = delegate_->GetEnvironment();
   } else {
     CHECK(GetZygoteForLaunch(), base::NotFatalUntil::M159);
diff --git a/content/browser/renderer_host/render_frame_host_manager.cc b/content/browser/renderer_host/render_frame_host_manager.cc
index cdc682a..20f11c3 100644
--- a/content/browser/renderer_host/render_frame_host_manager.cc
+++ b/content/browser/renderer_host/render_frame_host_manager.cc
@@ -4985,6 +4985,15 @@ RenderFrameHostManager::GetSiteInstanceForNavigationRequest(
     request->ResetStateForSiteInstanceChange();
   }
 
+  // Domicile's engine fork. The embedder learns which renderer a main
+  // frame's navigation goes to before that renderer starts, so an Electron
+  // page with Node.js can start its own as Electron does. See
+  // chrome/browser/domicile/domicile_electron_page.h.
+  if (frame_tree_node_->IsOutermostMainFrame()) {
+    GetContentClient()->browser()->MainFrameNavigatesInto(
+        render_frame_host_.get(), dest_site_instance.get());
+  }
+
   return dest_site_instance;
 }
 
