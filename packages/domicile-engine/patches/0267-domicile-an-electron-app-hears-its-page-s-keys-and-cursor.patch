diff --git a/content/browser/renderer_host/render_widget_host_impl.cc b/content/browser/renderer_host/render_widget_host_impl.cc
index cbc4447..f863df8 100644
--- a/content/browser/renderer_host/render_widget_host_impl.cc
+++ b/content/browser/renderer_host/render_widget_host_impl.cc
@@ -2065,9 +2065,77 @@ void RenderWidgetHostImpl::ForwardKeyboardEventWithCommands(
     return;
   }
 
+  input::NativeWebKeyboardEvent event = key_event;
+  event.is_browser_shortcut = is_shortcut;
+  // Domicile: the delegate may hold the event, as an Electron app's
+  // before-input-event does until the app answers. One behind a held event
+  // waits its turn, held or not.
+  const bool held =
+      delegate_ && delegate_->DomicileHoldKeyboardEvent(this, event);
+  if (held || !domicile_held_keys_.empty()) {
+    domicile_held_keys_.push_back(DomicileHeldKey{.event = std::move(event),
+                                                  .latency = latency,
+                                                  .commands = std::move(commands),
+                                                  .held = held});
+    return;
+  }
+  DomicileDispatchKeyboardEvent(event, latency, std::move(commands));
+}
+
+void RenderWidgetHostImpl::DomicileReleaseHeldKeyboardEvent(bool send) {
+  CHECK(!domicile_held_keys_.empty() && domicile_held_keys_.front().held)
+      << "a delegate released a keyboard event it did not hold";
+  DomicileHeldKey released = std::move(domicile_held_keys_.front());
+  domicile_held_keys_.pop_front();
+  // The Chars and the KeyUp of a dropped key-down go with it, as with a
+  // key-down PreHandleKeyboardEvent handles.
+  bool dropping_chars =
+      !send && released.event.GetType() == WebKeyboardEvent::Type::kRawKeyDown;
+  if (dropping_chars) {
+    suppressed_keys_.insert(static_cast<ui::DomCode>(released.event.dom_code));
+  }
+  if (send) {
+    DomicileSendReleasedKeyboardEvent(std::move(released));
+  } else if (released.event.GetType() == WebKeyboardEvent::Type::kKeyUp) {
+    // A dropped KeyUp lets go of its key-down's suppression too.
+    suppressed_keys_.erase(static_cast<ui::DomCode>(released.event.dom_code));
+  }
+  while (!domicile_held_keys_.empty() && !domicile_held_keys_.front().held) {
+    DomicileHeldKey next = std::move(domicile_held_keys_.front());
+    domicile_held_keys_.pop_front();
+    if (next.event.GetType() == WebKeyboardEvent::Type::kRawKeyDown ||
+        next.event.GetType() == WebKeyboardEvent::Type::kKeyDown) {
+      dropping_chars = false;
+    }
+    if (!dropping_chars ||
+        next.event.GetType() != WebKeyboardEvent::Type::kChar) {
+      DomicileSendReleasedKeyboardEvent(std::move(next));
+    }
+  }
+  // Its Chars still to come are dropped as they arrive, and its KeyUp as
+  // suppressed_keys_ drops one.
+  if (dropping_chars && domicile_held_keys_.empty()) {
+    suppress_events_until_keydown_ = true;
+  }
+}
+
+void RenderWidgetHostImpl::DomicileSendReleasedKeyboardEvent(
+    DomicileHeldKey key) {
+  // The KeyUp of a key-down that was dropped while it waited.
+  if (key.event.GetType() == WebKeyboardEvent::Type::kKeyUp &&
+      suppressed_keys_.erase(static_cast<ui::DomCode>(key.event.dom_code))) {
+    return;
+  }
+  DomicileDispatchKeyboardEvent(key.event, key.latency,
+                                std::move(key.commands));
+}
+
+void RenderWidgetHostImpl::DomicileDispatchKeyboardEvent(
+    const input::NativeWebKeyboardEvent& key_event,
+    const ui::LatencyInfo& latency,
+    std::vector<blink::mojom::EditCommandPtr> commands) {
   input::NativeWebKeyboardEventWithLatencyInfo key_event_with_latency(key_event,
                                                                       latency);
-  key_event_with_latency.event.is_browser_shortcut = is_shortcut;
   GetRenderInputRouter()->DispatchInputEventWithLatencyInfo(
       key_event_with_latency.event, &key_event_with_latency.latency,
       &key_event_with_latency.event.GetModifiableEventLatencyMetadata());
@@ -2374,6 +2442,10 @@ void RenderWidgetHostImpl::FilterDropData(DropData* drop_data) {
 }
 
 void RenderWidgetHostImpl::SetCursor(const ui::Cursor& cursor) {
+  // Domicile: an Electron app's webContents hears its page's cursor.
+  if (delegate_) {
+    delegate_->DomicileCursorChanged(this, cursor);
+  }
   if (view_) {
     view_->UpdateCursor(cursor);
   }
