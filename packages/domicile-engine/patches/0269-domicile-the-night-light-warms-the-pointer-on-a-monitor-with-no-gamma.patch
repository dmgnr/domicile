+void DrmCursor::SetDomicileCursorTint(int64_t display_id,
+                                      const gfx::Rect& bounds_in_screen,
+                                      const std::array<float, 3>& gains) {
+  DCHECK_CALLED_ON_VALID_THREAD(ui_thread_checker_);
+  base::AutoLock lock(lock_);
+  CHECK(std::ranges::all_of(gains, [](float gain) {
+    return gain >= 0.f && gain <= 1.f;
+  })) << "domicile: a pointer tint's gains are 0 to 1";
+  const std::array<float, 3> was = TintLocked();
+  // A display unplugged keeps its entry, so one that takes its place would
+  // match both.
+  base::EraseIf(tints_, [&](const auto& entry) {
+    return entry.first != display_id && entry.second.first == bounds_in_screen;
+  });
+  tints_[display_id] = {bounds_in_screen, gains};
+  // Redrawn only when the pointer's own display changed, so a fade on another
+  // monitor sends nothing.
+  if (window_ != gfx::kNullAcceleratedWidget && TintLocked() != was) {
+    SendCursorShowLocked();
+  }
+}
+
 void DrmCursor::MoveCursorTo(gfx::AcceleratedWidget window,
                              const gfx::PointF& location) {
   TRACE_EVENT0("drmcursor", "DrmCursor::MoveCursorTo (window)");
@@ -545,8 +570,34 @@ void DrmCursor::SendCursorShowLocked() EXCLUSIVE_LOCKS_REQUIRED(lock_) {
     return;
   }
 
-  CursorSetLockTested(window_, cursor_->bitmaps(), cursor_->hotspot(),
-                      GetBitmapLocationLocked(), cursor_->frame_delay());
+  // DOMICILE: warmed on a display whose night light is viz's color matrix,
+  // which the cursor plane skips: one with no gamma, or in HDR. Elsewhere the
+  // CRTC's ramp warms it.
+  const std::array<float, 3> tint = TintLocked();
+  if (tint == kUntinted) {
+    CursorSetLockTested(window_, cursor_->bitmaps(), cursor_->hotspot(),
+                        GetBitmapLocationLocked(), cursor_->frame_delay());
+    return;
+  }
+  CursorSetLockTested(window_, TintedCursorBitmaps(cursor_->bitmaps(), tint),
+                      cursor_->hotspot(), GetBitmapLocationLocked(),
+                      cursor_->frame_delay());
+}
+
+// DOMICILE: the gains of the display the pointer's window shows, matched by
+// its rectangle. Untinted on a display that has none.
+std::array<float, 3> DrmCursor::TintLocked() EXCLUSIVE_LOCKS_REQUIRED(lock_) {
+  const auto screen =
+      std::ranges::find(screens_, window_, &PointerScreen::window);
+  if (screen == screens_.end()) {
+    return kUntinted;
+  }
+  for (const auto& [display, tint] : tints_) {
+    if (tint.first == screen->bounds_in_screen) {
+      return tint.second;
+    }
+  }
+  return kUntinted;
 }
 
