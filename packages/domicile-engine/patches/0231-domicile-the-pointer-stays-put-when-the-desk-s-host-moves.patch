+  void SetDomicilePointerStays(gfx::AcceleratedWidget window);
+
   // DOMICILE: the window that hears the pointer, and where in its pixels. See
   // `PointerHeardAt`.
   std::optional<PointerHeard> Heard();
@@ -133,6 +138,7 @@ class DrmCursor : public CursorDelegateEvdev {
   PointerScreen& ScreenLocked(gfx::AcceleratedWidget window);
   void CrossLocked(const PointerCrossing& crossing);
   void MoveLocked(const PointerCrossing& to);
+  void ReturnStrandedLocked();
 
   void MoveCursorToOnEvdevThread(const gfx::PointF& screen_location);
   void MoveCursorToOnUiThread(const gfx::PointF& screen_location);
@@ -182,6 +188,17 @@ class DrmCursor : public CursorDelegateEvdev {
       gfx::kNullAcceleratedWidget;
   base::flat_map<int, gfx::Rect> absolute_areas_ GUARDED_BY(lock_);
   PointerConfinement confinement_ GUARDED_BY(lock_);
+  // DOMICILE: where on the engine's desktop the pointer was when its window
+  // moved off that spot and no other window held it. The window that holds it
+  // next takes the pointer back there. Any move of the pointer clears it.
+  std::optional<gfx::PointF> stranded_ GUARDED_BY(lock_);
+  // DOMICILE: the window the browser is moving to another display, while it
+  // does. See `SetDomicilePointerStays`.
+  gfx::AcceleratedWidget stays_through_move_ GUARDED_BY(lock_) =
+      gfx::kNullAcceleratedWidget;
+  // DOMICILE: the window a stranded pointer went back to during that move.
+  gfx::AcceleratedWidget returned_to_ GUARDED_BY(lock_) =
+      gfx::kNullAcceleratedWidget;
 
   const raw_ptr<DrmWindowHostManager> window_manager_
       GUARDED_BY_CONTEXT(ui_thread_checker_);  // Not owned.
diff --git a/ui/ozone/platform/drm/ozone_platform_drm.cc b/ui/ozone/platform/drm/ozone_platform_drm.cc
index 0d8a21c..a84ee16 100644
--- a/ui/ozone/platform/drm/ozone_platform_drm.cc
+++ b/ui/ozone/platform/drm/ozone_platform_drm.cc
@@ -193,6 +193,12 @@ class OzonePlatformDrm : public OzonePlatform {
     }
   }
 
+  void SetDomicilePointerStays(gfx::AcceleratedWidget window) override {
+    if (cursor_) {
+      cursor_->SetDomicilePointerStays(window);
+    }
+  }
+
   void SetDomicileDeskHost(gfx::AcceleratedWidget host) override {
     if (window_manager_) {
       window_manager_->set_desk_host(host);
diff --git a/ui/ozone/public/ozone_platform.h b/ui/ozone/public/ozone_platform.h
index 385de5a..cd496cf 100644
--- a/ui/ozone/public/ozone_platform.h
+++ b/ui/ozone/public/ozone_platform.h
@@ -510,6 +510,13 @@ class COMPONENT_EXPORT(OZONE) OzonePlatform {
   // (docs/architecture/ONE-PAGE-FOR-THE-DESK.md). `gfx::kNullAcceleratedWidget`
   // gives each window its own events again. DRM only, like the layout above.
   virtual void SetDomicileDeskHost(gfx::AcceleratedWidget host) {}
+  // DOMICILE: while `window` is set, moving it to another display leaves the
+  // pointer where it is on screen rather than carrying it along, waiting for
