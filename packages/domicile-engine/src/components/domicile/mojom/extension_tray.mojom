module domicile.mojom;

// Extensions for the shell's tray: their actions, and every installed
// extension for a menu that switches and configures them.
//
// A separate interface from ControlChannel because action state lives in the
// browser process (ExtensionActionManager), not the compositor.
//
// The browser binds this only for shell-origin documents, as with
// ControlChannel, so extension popups and <webview> sites cannot reach it.
//
// See docs/architecture/EXTENSIONS.md in the Domicile repository.

// One extension's action as the tray draws it. The state is for the active
// tab (the last focused <webview>), or the action's default if there is none.
// The list is resent when the active tab changes.
struct TrayExtension {
  // The id Activate takes.
  string id;
  string name;
  // The action's tooltip.
  string title;
  // data:image/png;base64,..., at the page's device scale factor. Not a
  // chrome-extension:// URL, because action.setIcon({imageData}) icons have no
  // URL.
  string icon;
  string badge_text;
  // A CSS color, #rrggbbaa. Transparent if the extension set none.
  string badge_color;
  // The popup URL, or empty if a click only calls Activate. A string rather
  // than a nullable url.mojom.Url, so Blink needs no optional KURL typemap.
  string popup;
  // False after action.disable().
  bool enabled;
  // The id of the browser profile it is in, which its popup opens in: the
  // one SetProfile names, or the default profile's until that loads.
  string profile;
};

// Where an extension runs on the sites it asks for, as chrome://extensions'
// "Site access" offers.
enum SiteAccess {
  // Only on a site where its action was clicked (activeTab).
  kOnClick,
  // Only on ExtensionSettings.sites.
  kSpecificSites,
  // Everywhere it asks to.
  kAllSites,
};

// An extension's chrome://extensions settings. Each is null where it is not
// being set, or where the extension cannot use it.
struct ExtensionSettings {
  // Runs on file:// pages.
  bool? file_access;
  // May use chrome.userScripts.
  bool? user_scripts;
  SiteAccess? site_access;
  // With kSpecificSites: hosts, each also as `*.host` for its subdomains.
  array<string> sites;
};

// One extension installed in the shell's profile, switched on or off, for a
// menu that manages them. Apps, themes and Chrome's own are left out, as
// chrome://extensions leaves them out.
struct InstalledExtension {
  string id;
  string name;
  // The manifest's icon as data:image/png;base64,..., at the page's device
  // scale factor. Chrome's placeholder until the icon loads.
  string icon;
  bool enabled;
  ExtensionSettings settings;
  // The settings the desk's config sets, each true or false as set. Only the
  // config changes these: Configure refuses them.
  ExtensionSettings config_settings;
  // The config installed it, so only the config uninstalls it.
  bool from_config;
  // Empty if it has no options page.
  string options_url;
};

// Renderer -> browser, bound per document.
interface ExtensionTray {
  // Sets the list's receiver. The list is sent immediately, so a reloaded page
  // is not left empty, and again on every change. A second call is a bad
  // message.
  SetClient(pending_remote<ExtensionTrayClient> client);

  // Shows the actions of browser profile `profile`'s extensions, as Chrome's
  // toolbar shows those of its window's profile, and has Activate click them
  // there: on the active tab of `profile`'s pages. The default profile's until
  // it is called. An id the desk has no profile for shows the default
  // profile's, and says so in the log; a shell asks for the profile of the
  // page it last focused, which may have gone with the config.
  SetProfile(string profile);

  // Clicks the action, as ExtensionActionRunner::RunAction does for a toolbar
  // click. Grants activeTab on the active tab, then dispatches
  // `action.onClicked` unless the action has a popup, which the shell opens
  // itself. An unknown or disabled id is ignored; the click may have raced an
  // uninstall.
  Activate(string id);

  // Switches extension `id` on or off, as its user would on
  // chrome://extensions. Answers with why not, or an empty string.
  SetEnabled(string id, bool enabled) => (string error);

  // Sets each of `settings` that is set on extension `id`. Answers with why
  // not, or an empty string; then none is set. A setting the extension
  // cannot use, or the config sets, is refused.
  Configure(string id, ExtensionSettings settings) => (string error);

  // Uninstalls extension `id`, as its user would. Answers with why not, or an
  // empty string. One the config installed is refused.
  Uninstall(string id) => (string error);
};

// Browser -> renderer.
interface ExtensionTrayClient {
  // The full list on every change, not a delta, so a missed message cannot
  // leave the page wrong.
  ExtensionsChanged(array<TrayExtension> extensions);

  // Every installed extension, on SetClient and on every change: one
  // installed, uninstalled, switched on or off, or reconfigured.
  InstalledChanged(array<InstalledExtension> extensions);

  // Extension `id` called `action.openPopup()`. The shell opens `popup` as it
  // opens a clicked action's. `popup` is carried because the extension may
  // set its action's popup back to none as soon as the call answers.
  // `profile` is the id of the browser profile it is in, which the popup
  // opens in.
  PopupRequested(string id, string popup, string profile);
};
