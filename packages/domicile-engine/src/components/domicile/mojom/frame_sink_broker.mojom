module domicile.mojom;

import "components/domicile/mojom/control_channel.mojom";
import "services/viz/public/mojom/compositing/compositor_frame_sink.mojom";
import "services/viz/public/mojom/compositing/frame_sink_id.mojom";
import "services/viz/public/mojom/compositing/local_surface_id.mojom";
import "ui/gfx/geometry/mojom/geometry.mojom";
import "gpu/ipc/common/exported_shared_image.mojom";
import "gpu/ipc/common/sync_token.mojom";
import "ui/gfx/mojom/buffer_types.mojom";
import "ui/gfx/mojom/color_space.mojom";
import "ui/gfx/mojom/gpu_fence_handle.mojom";
import "mojo/public/mojom/base/shared_memory.mojom";

// Tells a producer which surface to submit to.
//
// The embedder allocates the LocalSurfaceId and the producer adopts it, as
// RemoteFrame does for OOPIFs. Here the embedder is the page, so the
// embedding element's layout box drives xdg_toplevel.configure. The
// LocalSurfaceId's embed_token is the producer's permission to submit to that
// surface. See docs/architecture/ENGINE-FORK.md.
interface SurfaceObserver {
  // The embedder shows `size` of this producer's surface at
  // `local_surface_id`. Submit to that id at that size until told otherwise.
  //
  // This is xdg_toplevel.configure. `size` is in the page's device pixels and
  // `scale` is device pixels per CSS pixel, which converts back to the logical
  // pixels a client is configured in. Per embed, since each monitor's page has
  // its own scale.
  //
  // `zoom` is the embedding element's CSS `zoom`: the client draws `zoom`
  // times denser than `scale`, at a logical size `zoom` times smaller, so the
  // box stays `size` and the window stays sharp. 1 for an unzoomed element.
  OnSurfaceEmbedded(viz.mojom.LocalSurfaceId local_surface_id,
                    gfx.mojom.Size size,
                    double scale,
                    double zoom);

  // Viz no longer samples `buffer_id`, so the producer may draw into it.
  // Reusing a dmabuf viz is still reading causes tearing.
  //
  // This is wl_buffer.release.
  OnBufferReleased(uint64 buffer_id);
};

// A mode a connector advertises.
// Whether a connector scans out with a variable refresh rate.
enum AdaptiveSync {
  // The connector, its panel or its driver cannot.
  kUnsupported,
  // It can, and is not.
  kOff,
  // It is.
  kOn,
};

// Whether a connector is driven in HDR10 (BT.2020 with PQ).
enum Hdr {
  // Its panel's EDID takes no PQ, or it cannot scan out in 10 bits.
  kUnsupported,
  // It can, and is not.
  kOff,
  // It is.
  kOn,
};

struct DisplayMode {
  // In physical pixels.
  gfx.mojom.Size size;
  // In mHz, as wl_output.mode states it.
  int32 refresh_mhz;
};

// One display the browser sees, for the producer to advertise.
//
// `bounds` is the display's position on the browser's desktop in DIP. On the
// DRM platform nothing sets a scale factor, so DIP equals pixels.
struct Display {
  // Derived from the EDID, so it is stable across hotplug. The producer names
  // its wl_output after it, so a replugged monitor keeps the same wl_output.
  int64 id;
  gfx.mojom.Rect bounds;

  // The panel size in millimeters, or empty if the display reports none.
  //
  // The producer puts this in wl_output.geometry, which allows zero for
  // displays with no physical size. display::Display stores a DPI instead;
  // components/domicile/browser/display_list.cc and
  // ui/ozone/platform/drm/domicile/drm_screen.cc convert between the two.
  gfx.mojom.Size physical_size_mm;

  // The monitor's name, "<MAKE> <MODEL> <SERIAL>" from its EDID, or empty if
  // the EDID gives none.
  //
  // `id` is identity; this is what a user writes in config to pick a monitor,
  // and matches what kanshi and sway use. Built by
  // ui/ozone/platform/drm/domicile/edid_name.cc and carried in
  // display::Display as `label`. It includes the serial, which
  // display::EdidParser keeps only as a hash.
  string name;

  // The CRTC refresh rate in mHz, as wl_output.mode states it, or zero if
  // there is no mode. Clients are paced by wl_surface.frame, so zero is
  // harmless.
  int32 refresh_mhz;

  // The kernel's name for the display's connector ("HDMI-A-1"), or empty on a
  // platform with no connectors. The producer names a monitor with no `name`
  // after it, as sway does. Read in the GPU process by
  // ui/ozone/platform/drm/domicile/connector_name.cc.
  string connector;

  // How many entries the display's gamma ramp has, or 0 if it has none: a
  // DisplayLink dock, a virtual display, any platform but DRM. The producer
  // offers gamma control at this size. Read from the CRTC in the GPU process.
  uint32 gamma_size;

  // Every mode the connector advertises, which a profile can ask for in
  // `DisplayLayout.mode`. Empty on a platform that sets no modes. `bounds`
  // and `refresh_mhz` are the one it scans out.
  array<DisplayMode> modes;

  // Whether it scans out with a variable refresh rate, as the hardware says:
  // a profile asking for it gets `kOff` where the driver refused it.
  AdaptiveSync adaptive_sync;

  // Whether it is driven in HDR10, and its panel's luminances from the EDID
  // in cd/m², zero where unreported.
  Hdr hdr;
  float max_luminance;
  float max_average_luminance;
  float min_luminance;
  // In HDR, the luminance SDR content's white is shown at; zero otherwise.
  float sdr_white_nits;
};

// One display's gamma ramp: each channel 0 to 65535, all the same length.
// Empty channels draw colors as they are.
struct GammaRamp {
  array<uint16> red;
  array<uint16> green;
  array<uint16> blue;
};

// How the producer wants one display's connector driven.
//
// `Display` is what the browser read from the hardware; this is what the
// compositor's config says to do with it. It crosses processes because the
// compositor owns the config and the browser holds DRM master. See
// docs/architecture/A-DESKTOP-ON-A-TTY.md, "Outputs".
struct DisplayLayout {
  // A `Display.id` the browser sent.
  int64 id;

  // Whether to light this connector.
  //
  // `false` comes from a profile's `enabled: false`, e.g. to turn off a laptop
  // panel when the lid is shut on a full desk.
  bool enabled;

  // The mode's position on the browser's desktop, in physical pixels. Ignored
  // when `enabled` is false.
  gfx.mojom.Point origin;

  // The monitor's rotation and its device pixels per logical pixel. The
  // browser applies both to the window on this connector, so the page lays out
  // upright in logical pixels. Read even when `enabled` is false, because the
  // window persists while the connector is dark.
  DisplayTransform transform;
  double scale;

  // The display's rectangle in the shell's logical desktop, from the profile.
  // Used to move the pointer between monitors, since `origin` does not encode
  // which monitor is beside which. Empty when `enabled` is false, except for a
  // sleeping display, which keeps its place on the desk page.
  gfx.mojom.Rect desk;

  // The mode to scan out, from the profile, or null for the native one. A
  // size the connector does not advertise gets the native mode.
  gfx.mojom.Size? mode;

  // The refresh rate to scan out, in mHz: the advertised one nearest it. Zero
  // for the native mode's, or the fastest at a non-native `mode`.
  int32 refresh_mhz;

  // Whether to scan out with a variable refresh rate where the connector can.
  bool adaptive_sync;

  // Whether to drive it in HDR10 where its panel takes it, and the luminance
  // to show SDR content's white at there, in cd/m².
  bool hdr;
  float sdr_white_nits;
};

// A tablet or touchscreen and the display it covers, from the producer's
// config. See docs/DISPLAYS.md, "Tablets and touchscreens".
struct PointerTarget {
  // The evdev device's name or `phys`, matched exactly.
  string device;

  // A `Display.id` the browser sent.
  int64 display_id;
};

// A monitor with no connector, from the producer. The desk extends onto it
// and only a capture shows it. See docs/CASTING-TO-TVS.md.
struct VirtualDisplay {
  // Its `Display.id`, picked by the producer with the top bit set so it never
  // collides with a connector's.
  int64 id;

  // Its mode, in physical pixels.
  gfx.mojom.Size mode;

  // Its refresh rate in mHz.
  int32 refresh_mhz;

  // Its name, such as the TV it is cast to.
  string name;
};

// One event of emulated input (EIS) for the desk, as a pointer and keyboard
// of the engine's own would send it. See
// docs/architecture/A-HEADLESS-DESKTOP.md.
enum DeskInputKind {
  // The pointer moved to `x`, `y`.
  kPointer,
  // Button `code`, an evdev code, went down or up.
  kButton,
  // A scroll by `x`, `y`: right and down are positive.
  kScroll,
  // Key `code`, an evdev code, went down or up.
  kKey,
};

struct DeskInput {
  DeskInputKind kind;

  // A point on the desk, or a scroll, in desk pixels.
  double x;
  double y;

  uint32 code;
  bool pressed;
};

// Tells a producer what the displays are.
//
// No Wayland request matches this, because a Wayland compositor normally
// reads the hardware itself. On a tty the engine holds DRM master and the
// compositor has no DRM backend. See docs/architecture/A-DESKTOP-ON-A-TTY.md,
// "Outputs".
interface DisplayListObserver {
  // The full list, primary first; a missing display was unplugged. Sent once
  // the browser has read the displays, and on every change.
  OnDisplaysChanged(array<Display> displays);
};

// An Electron app's view a listed browser window holds: its page, placed by
// the app in the window's page, in that page's CSS pixels.
struct ListedBrowserView {
  // As `CaptureBrowserWindow` takes it.
  string id;
  int32 x;
  int32 y;
  int32 width;
  int32 height;
};

// A browser window, as a capture tool lists it. See
// components/domicile/browser/browser_window_listing.h.
struct ListedBrowserWindow {
  // A `BrowserWindow.id` (browser_windows.mojom), as `CaptureBrowserWindow`
  // takes it.
  string id;
  // The page's title, or empty.
  string title;
  // The app window's id, or empty for any other window.
  string app_id;
  // The address it shows, or the one it is opening.
  string url;
  // Whether it is a private window.
  bool off_the_record;
  // The views it holds and shows, bottom first: an Electron app's
  // `WebContentsView`s, which a shot of the window draws over its page.
  array<ListedBrowserView> views;
};

// Tells a producer which browser windows are open, so it can list them for
// capture tools beside its own windows.
interface BrowserWindowListObserver {
  // The full list. Sent on observing, and when a window opens, closes or
  // changes its title.
  OnBrowserWindowsChanged(array<ListedBrowserWindow> windows);
};

// What an input device is. A device can be more than one, and is then listed
// once for each.
enum InputDeviceKind {
  kKeyboard,
  kMouse,
  kTouchpad,
  kTouchscreen,
  kPointingStick,
  kGraphicsTablet,
  // Read for its keys or switches alone, like a power button or a lid.
  kOther,
};

// How an input device is attached. Mirrors ui::InputDeviceType.
enum InputDeviceConnection {
  kUnknown,
  kInternal,
  kUsb,
  kBluetooth,
};

// An input device the browser reads, as `domicile list-inputs` lists it.
struct ListedInputDevice {
  // ui::InputDevice::id, which holds while the device stays plugged in.
  int32 id;
  string name;
  InputDeviceKind kind;
  InputDeviceConnection connection;
  // Its device under /sys, or empty.
  string sys_path;
  uint16 vendor_id;
  uint16 product_id;
};

// Tells a producer which input devices the browser reads, so it can list them.
interface InputDeviceListObserver {
  // The full list, in the order the browser found them. Sent on observing,
  // and when a device is plugged or unplugged.
  OnInputDevicesChanged(array<ListedInputDevice> devices);
};

// Which clipboard: the Ctrl-C clipboard or the primary selection.
enum Clipboard {
  kCopy,
  kPrimary,
};

// Tells a producer what was copied in the browser.
//
// The browser is not a Wayland client, so without this its copies would not
// reach the seat. See ui/ozone/platform/drm/domicile/drm_clipboard.h.
interface ClipboardObserver {
  // What was copied, by MIME type: its text under
  // "text/plain;charset=utf-8" and its image under the image's type. Empty
  // when the copy was neither. The producer puts it on the seat; nothing
  // waits for that.
  OnCopied(Clipboard clipboard, map<string, array<uint8>> contents);
};

// Tells a producer whether the browser composites on the GPU or in memory.
//
// A GPU process that falls back to software shows no dmabuf, so the producer
// hands it windows in shared memory instead. See
// docs/architecture/A-DESKTOP-ON-A-TTY.md#software-output.
interface CompositingObserver {
  // True when the browser composites in memory. Sent once known, and on every
  // change.
  OnCompositingChanged(bool in_memory);
};

// A captured frame's pixels.
union CapturedPixels {
  // GPU compositing: a dmabuf.
  gfx.mojom.GpuMemoryBufferHandle dmabuf;
  // Software compositing: rows `CapturedFrame.stride` bytes apart from the
  // region's start.
  mojo_base.mojom.ReadOnlySharedMemoryRegion shm;
};

// One frame of a display, as viz composited it.
struct CapturedFrame {
  CapturedPixels pixels;
  // The DRM fourcc: ARGB8888 or ABGR8888, which viz picks.
  uint32 fourcc;
  // The buffer's size. Only `content` holds the display; viz letterboxes the
  // rest when the display's aspect differs from the requested size.
  gfx.mojom.Size size;
  // Bytes per row of `shm`. Zero for a dmabuf, whose planes carry it.
  uint32 stride;
  gfx.mojom.Rect content;
  // What changed since the previous frame, in buffer pixels. Empty means
  // everything.
  gfx.mojom.Rect damage;
};

// Holds a captured frame's buffer. Closing it gives the buffer back to viz,
// which may then draw the next frame into it.
interface CapturedFrameHold {};

// Hears one capture's frames: of a display, or of a browser window.
interface DisplayCaptureObserver {
  // A frame, sent when the display changed and no sooner than the frame
  // rate cap allows. Read it, then close `hold`. Viz keeps a few buffers, so
  // holding every frame stalls the capture.
  OnFrameCaptured(CapturedFrame frame, pending_remote<CapturedFrameHold> hold);
};

// Controls one capture: of a display, or of a browser window. Closing it stops
// the capture.
//
// When the browser ends a capture that failed, it closes this pipe and the
// observer's with the cause as the disconnect reason's description.
interface DisplayCapture {
  // Captures at `size` from the next frame on, letterboxed to keep the
  // source's aspect.
  Resize(gfx.mojom.Size size);
};

// Brokers viz frame sinks to a producer that is not a renderer.
//
// blink.mojom.EmbeddedFrameSinkProvider requires a FrameSinkId in the
// caller's child-process namespace. A producer outside the browser's process
// tree has none, so the browser allocates the id from its own namespace.
interface FrameSinkBroker {
  // Allocates a FrameSinkId, registers it with viz, and binds `receiver` to
  // the CompositorFrameSink. An embedder names the surface by the returned id;
  // `observer` tells the producer which surface it got.
  //
  // The sink starts outside any frame sink hierarchy and unembedded:
  //
  //   - Drawing needs an embedder to name the SurfaceId in a SurfaceDrawQuad.
  //   - BeginFrames need hierarchy registration. Without it a producer can
  //     still submit with a manual BeginFrameAck.
  //
  // Both happen when an embedder appears, announced by SurfaceObserver. The
  // producer and page may connect in either order.
  //
  // Without `observer` the producer cannot learn a LocalSurfaceId and so
  // cannot submit. This is useful only in tests.
  //
  // `app_id` names the window. The broker matches it against an <app>
  // element's app name to pick the surface to embed. It is also the frame
  // sink's viz debug label. If two sinks share an app id, the first found wins;
  // that is a producer bug.
  //
  // A producer that builds its own CompositorFrames passes `client` and
  // `receiver`, which are forwarded to viz. The spike's submitters do this,
  // since a solid color needs no GPU resource.
  //
  // **Pass neither to have the browser own the sink.** A dmabuf producer has
  // no GPU channel to mint mailboxes, so it imports buffers with ImportBuffer
  // and names them in SubmitBuffer, and the browser builds the frame.
  // Releases then arrive through SurfaceObserver.
  CreateFrameSink(
      pending_remote<viz.mojom.CompositorFrameSinkClient>? client,
      pending_receiver<viz.mojom.CompositorFrameSink>? receiver,
      pending_remote<SurfaceObserver>? observer,
      string app_id)
      => (viz.mojom.FrameSinkId frame_sink_id);

  // Embeds the producer's sink `child` in its sink `parent`, as a page's
  // <app> embeds a window: registers the hierarchy and tells `child`'s
  // observer `local_surface_id`. For a window's subsurfaces, which the
  // producer draws into the window's own frames.
  //
  // The producer allocates `local_surface_id`, since it embeds the surface.
  // A sink this producer did not create is a bad message.
  EmbedFrameSink(viz.mojom.FrameSinkId child,
                 viz.mojom.FrameSinkId parent,
                 viz.mojom.LocalSurfaceId local_surface_id,
                 gfx.mojom.Size size,
                 double scale);

  // Imports a dmabuf and returns its id, or 0 on failure.
  //
  // This is zwp_linux_dmabuf_v1. The browser does what
  // components/exo/buffer.cc does (NativePixmap, SharedImage,
  // TransferableResource), since it has the SharedImageInterface. The buffer
  // lives until DestroyBuffer or until the sink is destroyed.
  //
  // `exported` is the SharedImage as a mailbox and verified sync token. A
  // producer that owns its sink can use it to build its own
  // TransferableResource. Null when the browser owns the sink.
  //
  // `fourcc` is the client's DRM format. It is required because the byte order
  // decides whether red and blue are swapped.
  //
  // `color_space` is how the client's pixels encode color: sRGB unless it
  // described them with wp_color_management_v1. The SharedImage is made in
  // it, and viz converts from it to each display's.
  ImportBuffer(viz.mojom.FrameSinkId frame_sink_id,
               gfx.mojom.GpuMemoryBufferHandle buffer_handle,
               gfx.mojom.Size size,
               uint32 fourcc,
               gfx.mojom.ColorSpace color_space)
      => (uint64 buffer_id, gpu.mojom.ExportedSharedImage? exported);

  // Submits a frame showing `buffer_id` with `damage`.
  //
  // This is wl_surface.commit. Only for sinks the browser owns.
  SubmitBuffer(viz.mojom.FrameSinkId frame_sink_id,
               uint64 buffer_id,
               gfx.mojom.Rect damage);

  // Makes the GPU wait for `fence` before anything reads `buffer_id`, and
  // returns the verified sync token a frame showing it must carry. Null when
  // the sink or buffer is unknown or there is no GPU.
  //
  // `fence` signals when the producer's draw into the buffer lands, so the
  // producer need not wait for it before submitting. Viz waits on the token,
  // which orders its read after the fence is in place.
  FenceBuffer(viz.mojom.FrameSinkId frame_sink_id,
              uint64 buffer_id,
              gfx.mojom.GpuFenceHandle fence)
      => (gpu.mojom.SyncToken? sync_token);

  // Drops an imported buffer the client destroyed. Send it only once viz has
  // returned the buffer, with the sync token viz last returned it with (empty
  // if viz never had it): its GPU may still be reading it, and a read that
  // finds no image draws a fallback image over the window. Buffers are also
  // dropped with their sink.
  DestroyBuffer(viz.mojom.FrameSinkId frame_sink_id,
                uint64 buffer_id,
                gpu.mojom.SyncToken read_done);

  // Destroys the sink and invalidates `frame_sink_id`. All sinks are also
  // destroyed when the connection drops.
  DestroyFrameSink(viz.mojom.FrameSinkId frame_sink_id);

  // How to drive the connectors; the reply to `OnDisplaysChanged`.
  //
  // The browser reads the hardware, but only the producer has the config.
  //
  // An empty list means no preference, and the browser lights what the
  // hardware reports. This matters when a profile that turned a panel off
  // stops matching after a monitor is unplugged: the panel must come back on.
  //
  // No reply, because the modeset completes later on the DRM thread. The
  // modeset triggers the next `OnDisplaysChanged` instead.
  ConfigureDisplays(array<DisplayLayout> layout);

  // Says which display each tablet or touchscreen covers, replacing the last
  // list. A device it does not name covers no display. Sent after each
  // `OnDisplaysChanged`, since the targets are display ids.
  ConfigurePointers(array<PointerTarget> targets);

  // Replaces touchpad and mouse configuration. Nested platforms use the host.
  ConfigureInput(string config);

  // Sets the virtual displays, replacing the last list. Each joins the next
  // `OnDisplaysChanged` like a connector, and is laid out by
  // `ConfigureDisplays` like one, but lights no CRTC.
  ConfigureVirtualDisplays(array<VirtualDisplay> displays);

  // Sets the gamma ramp of display `display_id`, a `Display.id`, for a night
  // light or a gamma-control client. The browser keeps each display's and sets
  // it again after each modeset. Ignored outside a tty, as `ConfigureDisplays`
  // is. Channels of different lengths are a bad message.
  SetGamma(int64 display_id, GammaRamp ramp);

  // Sets the 3x3 color matrix, row-major, that display `display_id` is drawn
  // with, in linear light: a night light on a display driven in HDR, where a
  // gamma ramp would bend the PQ curve. The identity undoes it. Ignored for a
  // display no browser window shows. Anything but nine finite numbers is a bad
  // message.
  SetColorMatrix(int64 display_id, array<float> matrix);

  // Delivers emulated input to the desk, as the engine's own devices' would
  // be: the shell sees it first. Ignored where the engine reads no input of
  // its own, as nested.
  InjectInput(DeskInput input);

  // Sets the contents of one of the desktop's clipboards.
  //
  // Pushed rather than fetched because the producer reads each selection as it
  // arrives, so pastes in a page are answered from this process's memory.
  //
  // `contents` is keyed by MIME type, as `OnCopied` sends it: text under any
  // text type, an image under its own. An empty map means an empty
  // clipboard. Send it, or the browser keeps offering the previous contents.
  SetClipboard(Clipboard clipboard, map<string, array<uint8>> contents);

  // Registers `observer` for copies made in the browser.
  //
  // Unlike `ObserveDisplays`, nothing is sent on registration. The producer
  // sets the initial clipboard with `SetClipboard`.
  ObserveClipboard(pending_remote<ClipboardObserver> observer);

  // Registers `observer` for the display list and sends the current list.
  //
  // Sending on registration means a producer that connects late need not wait
  // for a hotplug. If the browser has not read the displays yet, nothing is
  // sent until it has.
  ObserveDisplays(pending_remote<DisplayListObserver> observer);

  // Registers `observer` for how the browser composites and sends the current
  // mode, once known.
  ObserveCompositing(pending_remote<CompositingObserver> observer);

  // Registers a producer's browser window list observer. It hears the list
  // at once, then every change.
  ObserveBrowserWindows(pending_remote<BrowserWindowListObserver> observer);

  // Registers a producer's input device list observer. It hears the list at
  // once, then every change.
  ObserveInputDevices(pending_remote<InputDeviceListObserver> observer);

  // Captures what a display shows, for a screen cast. Viz runs a
  // FrameSinkVideoCapturer on the root frame sink of the browser window on
  // that display.
  //
  // `display_id` is a `Display.id`. Zero names the browser's only window, for
  // a nested or headless browser, which sends no displays.
  //
  // Frames are `size` (see `DisplayCapture.Resize`), sent only on damage and
  // at most `max_fps` a second. They are dmabufs when the browser composites
  // on the GPU, shared memory otherwise.
  //
  // Replies false, and closes both pipes, when no browser window shows that
  // display.
  CaptureDisplay(int64 display_id,
                 gfx.mojom.Size size,
                 uint32 max_fps,
                 pending_receiver<DisplayCapture> capture,
                 pending_remote<DisplayCaptureObserver> observer)
      => (bool started);

  // Captures what one browser window's page shows, alone: viz runs the
  // capturer on the page's own frame sink, so nothing the shell draws over the
  // window is in it.
  //
  // `window_id` is a `BrowserWindow.id` (browser_windows.mojom). Frames are
  // the page's size in pixels until `DisplayCapture.Resize`, and otherwise as
  // for `CaptureDisplay`.
  //
  // Replies false, and closes both pipes, when no such window has a page with
  // a size, as a closed window or one never shown does not.
  CaptureBrowserWindow(string window_id,
                       uint32 max_fps,
                       pending_receiver<DisplayCapture> capture,
                       pending_remote<DisplayCaptureObserver> observer)
      => (bool started);
};
