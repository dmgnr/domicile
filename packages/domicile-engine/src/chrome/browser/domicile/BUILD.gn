# The fork's browser-side code that needs //chrome: the command socket, the
# desk, browser windows, extensions, history, site data, file dialogs,
# permission prompts, device choosers, links for applications, sign-ins,
# other prompts, refusing Chrome's own dialogs, printing and pointer warps.
#
# A separate target because //chrome/browser:browser accepts no new sources,
# and it keeps the fork to one added dependency in a Chromium-owned file.
# It lives in //chrome because it needs browser windows, profiles and aura
# hosts. Code that does not is in //components/domicile, with the tests.
source_set("domicile") {
  sources = [
    "domicile_browser_windows.cc",
    "domicile_browser_windows.h",
    "domicile_cast_sinks.cc",
    "domicile_cast_sinks.h",
    "domicile_chrome_dialogs.cc",
    "domicile_chrome_dialogs.h",
    "domicile_command_socket.cc",
    "domicile_command_socket.h",
    "domicile_desk.cc",
    "domicile_desk.h",
    "domicile_desk_activity.cc",
    "domicile_desk_activity.h",
    "domicile_desk_pointer.cc",
    "domicile_desk_pointer.h",
    "domicile_desk_presenters.cc",
    "domicile_desk_presenters.h",
    "domicile_device_chooser.cc",
    "domicile_device_chooser.h",
    "domicile_desk_functions.cc",
    "domicile_desk_functions.h",
    "domicile_devtools.cc",
    "domicile_devtools.h",
    "domicile_downloads.cc",
    "domicile_downloads.h",
    "domicile_extension_installer.cc",
    "domicile_extension_installer.h",
    "domicile_extension_settings.cc",
    "domicile_extension_settings.h",
    "domicile_extension_tray.cc",
    "domicile_extension_tray.h",
    "domicile_external_apps.cc",
    "domicile_external_apps.h",
    "domicile_file_dialogs.cc",
    "domicile_file_dialogs.h",
    "domicile_history.cc",
    "domicile_history.h",
    "domicile_media_devices.cc",
    "domicile_media_devices.h",
    "domicile_modifier_taps.cc",
    "domicile_modifier_taps.h",
    "domicile_permissions.cc",
    "domicile_permissions.h",
    "domicile_picture_in_picture.cc",
    "domicile_picture_in_picture.h",
    "domicile_pointer_hiding.cc",
    "domicile_pointer_hiding.h",
    "domicile_pointer_warp.cc",
    "domicile_pointer_warp.h",
    "domicile_printing.cc",
    "domicile_printing.h",
    "domicile_prompts.cc",
    "domicile_prompts.h",
    "domicile_shell_fetch.cc",
    "domicile_shell_fetch.h",
    "domicile_shell_windows.cc",
    "domicile_shell_windows.h",
    "domicile_sign_in.cc",
    "domicile_sign_in.h",
    "domicile_site_data.cc",
    "domicile_site_data.h",
    "domicile_tab_helpers.cc",
    "domicile_tab_helpers.h",
    "domicile_window_controller.cc",
    "domicile_window_controller.h",
  ]

  # Public so //chrome/browser, which depends only on this target, starts it.
  public_deps = [ "//components/domicile:rtkit" ]

  deps = [
    "//base",
    # The TVs the shell casts the desktop to, through Chrome's Media Router.
    "//chrome/browser/media/router:media_router_feature",
    "//components/media_router/browser",
    "//components/media_router/common",
    "//third_party/webrtc_overrides:webrtc_component",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/web_applications",
    "//components/domicile:app_roots",
    # Finds a browser window's page for a capture of it alone.
    "//components/domicile:browser_window_capture_target",
    # Lists each browser window for capture tools.
    "//components/domicile:browser_window_listing",
    "//components/domicile:command_protocol",
    "//components/domicile:common",
    # Somebody at the desk, from ui::UserActivityDetector in //ui/base.
    "//components/domicile:desk_activity",
    # The desk's downloads, for the shell's Downloads pipe.
    "//components/domicile:desk_downloads",
    # Where the pointer is on the desk, from aura's own events.
    "//components/domicile:desk_pointer",
    # Hides the pointer while typing and after a pause, from aura's own events
    # and the touchpad gestures the shell and applications take.
    "//components/domicile:desk_gestures",
    "//components/domicile:desk_pointer_hiding",
    # Hears a tap of Super alone for the shell, from aura's own events.
    "//components/domicile:desk_modifier_taps",
    # Picture-in-picture videos, which the shell lists, shows and controls.
    "//components/domicile:picture_in_picture_videos",
    "//services/media_session/public/cpp",
    "//components/domicile:pointer_hiding",
    "//components/domicile:notification_window",
    "//components/domicile:pointer_warp",
    "//components/domicile:shell_source",
    "//components/domicile:shell_swap",
    "//components/domicile:shell_window_wait",
    "//components/domicile:shell_windows",
    "//components/tabs:public",
    "//content/public/browser",
    "//net",
    # `screenshot`: reads the shell page's surface back as a PNG.
    "//components/viz/common",
    # Installs the extensions the desk's config names into the profile.
    "//chrome/browser/extensions",
    "//chrome/browser/profiles:profile",
    # Private browsing ends with the last private page: the off-the-record
    # profile is destroyed through Chrome's ProfileDestroyer.
    "//chrome/browser/profiles:profile_manager",
    "//components/domicile:private_pages",
    "//chrome/common:constants",
    "//components/domicile:extension_installer",
    # Each extension's chrome://extensions settings.
    "//components/domicile:extension_settings",
    "//components/prefs",
    "//extensions/browser",
    "//extensions/common",
    "//extensions/common:mojom",
    # The shell's tray: extension actions and their icons as PNGs.
    "//components/domicile:extension_tray_entry",
    "//components/domicile/mojom",
    "//mojo/public/cpp/bindings",
    "//skia",
    "//ui/aura/domicile:desk_targeter",
    "//ui/gfx",
    "//ui/gfx/codec",
    "//url",
    # Tab helpers for <webview> guests (SessionTabHelper, HistoryTabHelper,
    # the favicon driver, WebNavigationTabObserver).
    "//chrome/browser/extensions/api/web_navigation",
    "//chrome/browser/favicon",
    "//chrome/browser/history",
    "//chrome/browser/sessions",
    # Guests as tabs of the desk's one window for chrome.tabs and
    # chrome.windows.
    "//chrome/common/extensions/api",
    "//components/domicile:desk_tabs",
    "//components/domicile:web_view_guest",
    "//components/sessions",
    "//components/sessions:session_id",
    # File dialogs, answered by the shell.
    "//components/domicile:file_choice",
    # The shell's own page's file dialogs, asked of the desktop's portal.
    "//components/domicile:portal_file_chooser",
    "//ui/shell_dialogs",
    # Permission prompts the shell answers, and guests' cameras and
    # microphones through Chrome's dispatcher.
    "//chrome/browser/media/webrtc",
    "//components/domicile:site_permissions",
    "//components/permissions",
    # Device choosers the shell answers, in place of Chrome's bubble (patch
    # 0110).
    "//chrome/browser/ui/dialogs:browser_dialogs",
    "//components/domicile:device_choices",
    # Links for applications the shell asks about, in place of Chrome's
    # dialog (patch 0176).
    "//chrome/browser/external_protocol",
    # Sign-ins the shell asks for, in place of Chrome's dialog (patch 0177).
    "//chrome/browser/ui/login",
    # File access, client certificate, Bluetooth pairing and extension prompts
    # the shell asks, in place of Chrome's dialogs (patch 0179).
    "//chrome/browser/bluetooth",
    "//chrome/browser/file_system_access",
    "//chrome/browser/ssl",
    "//components/permissions:permissions_common",
    # Any Chrome dialog left is refused, and the APIs whose only UI is a Chrome
    # sheet are off (patch 0183).
    "//components/web_modal",
    "//content/public/common",
    # The Settings app's site permissions, listed and set through the command
    # socket.
    "//components/content_settings/core/browser",
    "//components/content_settings/core/common",
    # The camera and microphone a page gets when it names none: Chrome's device
    # ranking in the profile's prefs (patch 0109), for the Settings app and the
    # shell.
    "//chrome/browser/media/prefs",
    # The History app's history, favicons and browsing data, through the
    # command socket.
    "//chrome/browser/browsing_data:constants",
    "//components/favicon/core",
    "//components/favicon_base",
    "//components/history/core/browser",
    "//components/keyed_service/core",
    # The Settings app's site data, through Chrome's BrowsingDataModel.
    "//chrome/browser/browsing_data",
    "//components/browsing_data/content",
    # DevTools for a guest's page: Chrome's front end and its bindings.
    "//chrome/browser/devtools",
    # Printing a guest's page: Chrome's PrintViewManager and its system
    # dialog.
    "//chrome/browser/printing",
    # Tab zoom factors and range.
    "//third_party/blink/public/common",
    "//ui/base/mojom:ui_base_types",
    "//ui/gfx/geometry",
    # Pointer warps move the cursor through an aura WindowTreeHost.
    "//ui/aura",
    "//ui/base",
    "//ui/display",
    # The pointer moves `StartDeskPointer` reports.
    "//ui/events",
    # Names the device an input came from, for the idle clock's log.
    "//ui/events/devices",
    # `gfx::NativeView`, which `display::Screen::GetDisplayNearestView` takes.
    "//ui/gfx:native_ui_types",
    # One page for the desk: its geometry, and a presenter window per extra
    # display (docs/architecture/ONE-PAGE-FOR-THE-DESK.md).
    "//components/domicile:desk_geometry",
    "//ui/compositor",
    "//ui/ozone",
    "//ui/views",
    # The shell's fetches with the profile's cookies: the profile's network
    # context, refused while the desk is locked.
    "//components/domicile:desk_lock",
    "//components/domicile:shell_fetch",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
  ]
}
