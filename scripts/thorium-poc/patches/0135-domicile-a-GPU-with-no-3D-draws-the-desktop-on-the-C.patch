+void DrmThread::DomicileCreateScanoutBuffer(
+    gfx::AcceleratedWidget widget,
+    const gfx::Size& size,
+    std::optional<DrmScanoutBuffer>* buffer) {
+  TRACE_EVENT0("drm", "DrmThread::DomicileCreateScanoutBuffer");
+  scoped_refptr<ui::DrmDevice> drm = device_manager_->GetDrmDevice(widget);
+  CHECK(drm) << "No devices available for buffer allocation.";
+  *buffer = AllocateDrmScanoutBuffer(drm, size);
+}
