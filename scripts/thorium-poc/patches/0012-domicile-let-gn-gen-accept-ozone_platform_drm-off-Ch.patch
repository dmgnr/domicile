@@ -6,18 +6,30 @@
 
 #include <cstdint>
 
-#include "ash/constants/ash_switches.h"
 #include "base/containers/ring_buffer.h"
 #include "base/logging.h"
 #include "base/metrics/histogram_functions.h"
 #include "base/syslog_logging.h"
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_CHROMEOS)
+#include "ash/constants/ash_switches.h"
+#endif
 
 namespace ui {
 
 PageFlipWatchdog::PageFlipWatchdog() {
+  // Flex is a ChromeOS brand, so off ChromeOS the answer is the ordinary
+  // threshold and there is nothing to ask. IsRevenBranding() is one of the
+  // two references to ChromeOS in the whole of this platform, and
+  // //ash/constants is in the target's deps for it alone.
+#if BUILDFLAG(IS_CHROMEOS)
   plane_assignment_flake_threshold = ash::switches::IsRevenBranding()
                                          ? kFlexPlaneAssignmentFlakeThreshold
                                          : kPlaneAssignmentFlakeThreshold;
+#else
+  plane_assignment_flake_threshold = kPlaneAssignmentFlakeThreshold;
+#endif
 }
 
 PageFlipWatchdog::~PageFlipWatchdog() = default;
@@ -50,9 +62,15 @@ void PageFlipWatchdog::CrashOnFailedPlaneAssignment() {
 
   // Metric to find good threshold for Flex device.
   // TODO(crbug.com/371609830): finalize this threshold.
+  //
+  // Not emitted off ChromeOS: Platform.FlexPageFlipFlakes2 is Flex telemetry,
+  // and a histogram recorded by a build that is not Flex would be noise in
+  // somebody else's experiment rather than data.
+#if BUILDFLAG(IS_CHROMEOS)
   if (ash::switches::IsRevenBranding()) {
     base::UmaHistogramCounts100("Platform.FlexPageFlipFlakes2", flakes);
   }
+#endif
 
   if (flakes >= plane_assignment_flake_threshold) {
     LOG(FATAL) << "Plane assignment has flaked " << flakes
diff --git a/ui/ozone/platform/drm/host/drm_cursor.cc b/ui/ozone/platform/drm/host/drm_cursor.cc
index 3204aebb..88d5688a 100644
--- a/ui/ozone/platform/drm/host/drm_cursor.cc
+++ b/ui/ozone/platform/drm/host/drm_cursor.cc
@@ -13,13 +13,22 @@
 #include "base/threading/thread_checker.h"
 #include "base/time/time.h"
 #include "base/trace_event/trace_event.h"
+#include "build/build_config.h"
 #include "ui/base/cursor/mojom/cursor_type.mojom.h"
 #include "ui/gfx/geometry/point_conversions.h"
 #include "ui/ozone/common/bitmap_cursor.h"
 #include "ui/ozone/platform/drm/host/drm_window_host.h"
 #include "ui/ozone/platform/drm/host/drm_window_host_manager.h"
 
+// `ui/events/ozone/BUILD.gn:44` compiles `chromeos/cursor_controller.cc` only
+// `if (is_chromeos)`. The header is in the tree on every platform, so this
+// include resolves and the call below compiles -- and then the link fails on
+// an undefined symbol, which is why it took a build rather than a `git grep`
+// to find. It is also why a grep for `include "chromeos/` did not see it: the
+// path is `ui/events/ozone/chromeos/`.
+#if BUILDFLAG(IS_CHROMEOS)
 #include "ui/events/ozone/chromeos/cursor_controller.h"
+#endif
 
 namespace ui {
 namespace {
@@ -231,9 +240,15 @@ void DrmCursor::MoveCursor(const gfx::Vector2dF& delta) {
   if (window_ == gfx::kNullAcceleratedWidget)
     return;
 
+  // `CursorController` applies the per-window cursor transform ChromeOS needs
+  // for display rotation and magnification. Off ChromeOS there is no such
+  // configuration and no `CursorController` to ask, so the delta is used as it
+  // arrived -- which is what an unrotated, unmagnified display wants anyway.
   gfx::Vector2dF transformed_delta = delta;
+#if BUILDFLAG(IS_CHROMEOS)
   ui::CursorController::GetInstance()->ApplyCursorConfigForWindow(
       window_, &transformed_delta);
+#endif
   SetCursorLocationLocked(location_ + transformed_delta);
   SendCursorMoveLocked();
 }
