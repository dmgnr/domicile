diff --git a/ui/ozone/platform/drm/BUILD.gn b/ui/ozone/platform/drm/BUILD.gn
index bf07dc36..b70f88a4 100644
--- a/ui/ozone/platform/drm/BUILD.gn
+++ b/ui/ozone/platform/drm/BUILD.gn
@@ -10,8 +10,17 @@ import("//gpu/vulkan/features.gni")
 import("//testing/test.gni")
 import("//ui/gl/features.gni")
 
-# This is ChromeOS-only.
-assert(is_chromeos, "Ozone DRM platform is ChromeOS-only")
+# ChromeOS is where this platform grew up, and everything in it that was
+# actually ChromeOS-only has been moved under an `is_chromeos` of its own by
+# the same patch that relaxed this line. What is left is libdrm, minigbm,
+# evdev and //ui/display/types, every one of which builds on desktop Linux.
+#
+# Relaxed rather than removed: this platform has no `PlatformScreen` and
+# nothing in the tree modesets for it without //ui/display/manager, so a
+# non-ChromeOS embedder that sets `ozone_platform_drm = true` is taking on
+# writing those. `is_linux` says the build can be configured, not that a
+# screen will light up. See docs/architecture/A-DESKTOP-ON-A-TTY.md.
+assert(is_linux || is_chromeos, "Ozone DRM platform needs Linux or ChromeOS")
 assert(!is_castos, "Ozone DRM platform no longer supports CastOS")
 
 visibility = [ "//ui/ozone/*" ]
@@ -161,10 +170,16 @@ source_set("gbm") {
     "//ui/platform_window",
   ]
 
-  deps += [
-    "//ash/constants",
-    "//ui/base/ime/ash",
-  ]
+  # THE ONLY TWO DEPS IN THIS TARGET THAT CANNOT BE BUILT OFF CHROMEOS: both
+  # `//ash/constants/BUILD.gn` and `//ui/base/ime/ash/BUILD.gn` open with
+  # `assert(is_chromeos)`. They are here for a page-flip flake threshold and
+  # for `CreateInputMethod`, and both of those now have a non-ash arm.
+  if (is_chromeos) {
+    deps += [
+      "//ash/constants",
+      "//ui/base/ime/ash",
+    ]
+  }
 
   if (!use_static_angle || is_chromeos) {
     data_deps = [
@@ -198,7 +213,6 @@ source_set("gbm_unittests") {
   sources = [
     "common/drm_util_unittest.cc",
     "common/hardware_display_controller_info_unittest.cc",
-    "gpu/drm_display_unittest.cc",
     "gpu/drm_gpu_display_manager_unittest.cc",
     "gpu/drm_gpu_util_unittest.cc",
     "gpu/drm_overlay_manager_unittest.cc",
@@ -211,15 +225,30 @@ source_set("gbm_unittests") {
     "gpu/fake_drm_device_generator.h",
     "gpu/gbm_surface_factory_unittest.cc",
     "gpu/hardware_display_controller_unittest.cc",
-    "gpu/hardware_display_plane_manager_unittest.cc",
     "gpu/mock_drm_device.cc",
     "gpu/mock_drm_device.h",
     "gpu/mock_drm_modifiers_filter.cc",
     "gpu/mock_drm_modifiers_filter.h",
     "gpu/proxy_helpers_unittest.cc",
-    "gpu/screen_manager_unittest.cc",
   ]
 
+  # `ui/display/manager/test/fake_display_snapshot.h` is the one thing this
+  # target reaches for that Linux does not have: `//ui/display:test_support`
+  # compiles `manager/test/*` only `if (is_chromeos)`, because
+  # `//ui/display/manager` itself asserts it. These two files are the only
+  # users of it in the platform, so they are the only ones gated.
+  if (is_chromeos) {
+    sources += [
+      "gpu/drm_display_unittest.cc",
+      "gpu/screen_manager_unittest.cc",
+
+      # Not fake_display_snapshot.h: this one drives
+      # `display::features::kCtmColorManagement`, which is itself declared only
+      # under `#if BUILDFLAG(IS_CHROMEOS)`.
+      "gpu/hardware_display_plane_manager_unittest.cc",
+    ]
+  }
+
   deps = [
     ":gbm",
     "//base/test:test_support",
