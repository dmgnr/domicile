From 329fc36a7b84072134473d66168d21e390a7ecbf Mon Sep 17 00:00:00 2001
From: Domicile Thorium POC <domicile-thorium-poc@invalid.example>
Date: Sat, 14 Nov 2026 13:24:10 +0700
Subject: [PATCH] domicile: port DRM modeset startup to Chromium 156

---
 ui/ozone/platform/drm/BUILD.gn              |  3 +++
 ui/ozone/platform/drm/ozone_platform_drm.cc | 17 +++++++++++++----
 2 files changed, 16 insertions(+), 4 deletions(-)

diff --git a/ui/ozone/platform/drm/BUILD.gn b/ui/ozone/platform/drm/BUILD.gn
index ffee3908..1d789a5c 100644
--- a/ui/ozone/platform/drm/BUILD.gn
+++ b/ui/ozone/platform/drm/BUILD.gn
@@ -120,6 +120,8 @@ source_set("gbm") {
     "host/drm_window_host.cc",
     "host/drm_window_host.h",
     "host/drm_window_host_manager.cc",
+    "domicile/drm_modeset.cc",
+    "domicile/drm_modeset.h",
     "domicile/drm_screen.cc",
     "domicile/drm_screen.h",
     "host/drm_window_host_manager.h",
@@ -232,6 +234,7 @@ source_set("gbm_unittests") {
     "gpu/mock_drm_modifiers_filter.cc",
     "gpu/mock_drm_modifiers_filter.h",
     "gpu/proxy_helpers_unittest.cc",
+    "domicile/drm_modeset_unittest.cc",
     "domicile/drm_screen_unittest.cc",
   ]
 
diff --git a/ui/ozone/platform/drm/ozone_platform_drm.cc b/ui/ozone/platform/drm/ozone_platform_drm.cc
index 662ee090..f6afcb05 100644
--- a/ui/ozone/platform/drm/ozone_platform_drm.cc
+++ b/ui/ozone/platform/drm/ozone_platform_drm.cc
@@ -46,6 +46,7 @@
 #include "ui/ozone/platform/drm/host/drm_display_host_manager.h"
 #include "ui/ozone/platform/drm/host/drm_native_display_delegate.h"
 #include "ui/ozone/platform/drm/host/drm_window_host.h"
+#include "ui/ozone/platform/drm/domicile/drm_modeset.h"
 #include "ui/ozone/platform/drm/domicile/drm_screen.h"
 #include "ui/ozone/platform/drm/host/drm_window_host_manager.h"
 #include "ui/ozone/platform/drm/host/host_drm_device.h"
@@ -100,11 +101,15 @@ class OzonePlatformDrm : public OzonePlatform {
     return std::make_unique<DrmScreen>(window_manager_.get());
   }
   void InitScreen(PlatformScreen* screen) override {
-    // The display list arrives from DrmNativeDisplayDelegate, which the
-    // modeset driver owns; until it has run there are no snapshots, and
-    // DrmScreen answers with the displayless fallback its header describes
-    // rather than with nothing.
+    // Start the modeset driver here, and not earlier, because here is where
+    // the screen it feeds first exists. It asks DrmNativeDisplayDelegate for
+    // the display list and lights what comes back; until that answer arrives
+    // DrmScreen reports the displayless fallback its header describes, which
+    // is why this seeds it rather than leaving the list empty.
     static_cast<DrmScreen*>(screen)->OnDisplaysChanged({});
+    modeset_ = std::make_unique<DrmModeset>(CreateNativeDisplayDelegate(),
+                                            static_cast<DrmScreen*>(screen));
+    modeset_->Start();
   }
 
   GpuPlatformSupportHost* GetGpuPlatformSupportHost() override {
@@ -383,6 +388,10 @@ class OzonePlatformDrm : public OzonePlatform {
   std::unique_ptr<DrmCursor> cursor_;
   std::unique_ptr<EventFactoryEvdev> event_factory_ozone_;
   std::unique_ptr<DrmDisplayHostManager> display_manager_;
+  // Domicile's engine fork: drives NativeDisplayDelegate so that something
+  // actually modesets. Declared after display_manager_ so it is destroyed
+  // before the manager whose delegate it holds.
+  std::unique_ptr<DrmModeset> modeset_;
   PlatformRuntimeProperties host_properties_;
 
   base::WeakPtrFactory<OzonePlatformDrm> weak_factory_{this};
-- 
2.56.0

