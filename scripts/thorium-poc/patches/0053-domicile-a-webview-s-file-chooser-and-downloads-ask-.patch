From 293323c4f859c7609d734f130fcbb9fb61a91271 Mon Sep 17 00:00:00 2001
From: Domicile Thorium POC <domicile-thorium-poc@invalid.example>
Date: Sat, 14 Nov 2026 14:11:14 +0700
Subject: [PATCH] domicile: port webview downloads and file chooser to Chromium
 156

---
 chrome/browser/chrome_browser_main.cc         |  4 +++
 chrome/browser/download/BUILD.gn              |  1 +
 .../chrome_download_manager_delegate.cc       | 29 +++++++++++++++++++
 .../renderer/bindings/generated_in_core.gni   |  2 ++
 .../blink/renderer/bindings/idl_in_core.gni   |  1 +
 .../blink/renderer/core/html/build.gni        |  2 ++
 6 files changed, 39 insertions(+)

diff --git a/chrome/browser/chrome_browser_main.cc b/chrome/browser/chrome_browser_main.cc
index e152b6e8..bdd890cc 100644
--- a/chrome/browser/chrome_browser_main.cc
+++ b/chrome/browser/chrome_browser_main.cc
@@ -1615,6 +1615,10 @@ void ChromeBrowserMainParts::PostProfileInit(Profile* profile,
   // drawn over the desktop. Before any window, so the shell's first page
   // already has none.
   domicile::TurnOffBrowserOffers(*profile->GetPrefs());
+  // And every download asks where it goes: the shell draws the picker, and a
+  // download saved to a folder nobody chose is a file the user never sees
+  // arrive -- this desktop has no download shelf to show it on.
+  profile->GetPrefs()->SetBoolean(prefs::kPromptForDownload, true);
 
   for (auto& chrome_extra_part : chrome_extra_parts_) {
     chrome_extra_part->PostProfileInit(profile, is_initial_profile);
diff --git a/chrome/browser/download/BUILD.gn b/chrome/browser/download/BUILD.gn
index fb1b41b0..b2d7210a 100644
--- a/chrome/browser/download/BUILD.gn
+++ b/chrome/browser/download/BUILD.gn
@@ -215,6 +215,7 @@ source_set("impl") {
     "//chrome/browser/ui/select_file_policy",
     "//chrome/common:non_code_constants",
     "//components/background_fetch",
+    "//components/domicile:web_view_guest",
     "//components/download/content/factory",
     "//components/enterprise/common/proto:connectors_proto_gen",
     "//components/enterprise/connectors/core",
diff --git a/chrome/browser/download/chrome_download_manager_delegate.cc b/chrome/browser/download/chrome_download_manager_delegate.cc
index 0cfc34d1..3497c6b9 100644
--- a/chrome/browser/download/chrome_download_manager_delegate.cc
+++ b/chrome/browser/download/chrome_download_manager_delegate.cc
@@ -4,6 +4,8 @@
 
 #include "chrome/browser/download/chrome_download_manager_delegate.h"
 
+#include "components/domicile/browser/web_view_guest.h"
+
 #include <algorithm>
 #include <memory>
 #include <optional>
@@ -1806,6 +1808,33 @@ void ChromeDownloadManagerDelegate::ShowFilePickerForDownload(
     const base::FilePath& suggested_path,
     DownloadTargetDeterminerDelegate::ConfirmationCallback callback) {
   DCHECK(download);
+
+  // A download from a page in a <webview> asks the shell where it goes,
+  // rather than opening a save dialog the browser draws over the desktop.
+  content::WebContents* web_contents =
+      content::DownloadItemUtils::GetWebContents(download);
+  if (domicile::WebViewGuest* guest =
+          web_contents ? domicile::WebViewGuest::FromWebContents(web_contents)
+                       : nullptr) {
+    guest->ChooseDownloadPath(
+        suggested_path,
+        base::BindOnce(
+            [](base::WeakPtr<ChromeDownloadManagerDelegate> delegate,
+               DownloadTargetDeterminerDelegate::ConfirmationCallback callback,
+               std::optional<base::FilePath> path) {
+              if (!delegate) {
+                return;
+              }
+              delegate->OnConfirmationCallbackComplete(
+                  std::move(callback),
+                  path ? DownloadConfirmationResult::CONFIRMED
+                       : DownloadConfirmationResult::CANCELED,
+                  path ? ui::SelectedFileInfo(*path) : ui::SelectedFileInfo());
+            },
+            weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+    return;
+  }
+
   DownloadFilePicker::ShowFilePicker(
       download, suggested_path,
       base::BindOnce(
