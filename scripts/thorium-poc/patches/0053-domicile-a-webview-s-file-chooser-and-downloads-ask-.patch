   "$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_html_web_view_element.cc",
   "$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_html_web_view_element.h",
+  "$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_domicile_file_chooser_event.cc",
+  "$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_domicile_file_chooser_event.h",
   "$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_domicile_new_window_event.cc",
   "$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_domicile_new_window_event.h",
