   std::unique_ptr<base::Thread> thread_;
diff --git a/ui/events/ozone/evdev/input_device_factory_evdev.cc b/ui/events/ozone/evdev/input_device_factory_evdev.cc
index 5e26d25b..79074020 100644
--- a/ui/events/ozone/evdev/input_device_factory_evdev.cc
+++ b/ui/events/ozone/evdev/input_device_factory_evdev.cc
@@ -112,6 +112,24 @@ InputDeviceFactoryEvdev::InputDeviceFactoryEvdev(
       imposter_checker_(new ImposterCheckerEvdev()),
       input_device_opener_(std::move(input_device_opener)),
       input_controller_(input_controller) {
+  // THE OPENER'S WAY BACK IN, handed over here because an opener is built in
+  // order to be given to this factory and so cannot be given this factory
+  // first. `base::Unretained` is safe for the same reason: the opener is owned
+  // here and cannot outlive what owns it.
+  //
+  // Closing a device and opening it again is the only thing that re-arms the
+  // watch on it -- `AttachInputDevice` is the sole caller of
+  // `EventConverterEvdev::Start()` -- and an opener whose descriptors can be
+  // revoked under it (Domicile's, from logind, on a console switch) has no
+  // other way to get a device reading again. The explicit detach ahead of the
+  // open matters: `AttachInputDevice` would detach too, but it runs a task
+  // later, which would leave the dead converter watching in between.
+  input_device_opener_->SetDeviceReopener(base::BindRepeating(
+      [](InputDeviceFactoryEvdev* factory, int id, const base::FilePath& path) {
+        factory->RemoveInputDevice(path);
+        factory->AddInputDevice(id, path);
+      },
+      base::Unretained(this)));
 }
 
 InputDeviceFactoryEvdev::~InputDeviceFactoryEvdev() = default;
diff --git a/ui/events/ozone/evdev/input_device_opener.h b/ui/events/ozone/evdev/input_device_opener.h
index fda925ba..7d6ca2a9 100644
--- a/ui/events/ozone/evdev/input_device_opener.h
+++ b/ui/events/ozone/evdev/input_device_opener.h
@@ -5,7 +5,11 @@
 #ifndef UI_EVENTS_OZONE_EVDEV_INPUT_DEVICE_OPENER_H_
 #define UI_EVENTS_OZONE_EVDEV_INPUT_DEVICE_OPENER_H_
 
+#include <memory>
+
 #include "base/component_export.h"
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
 #include "base/memory/raw_ptr.h"
 #include "ui/events/ozone/evdev/event_converter_evdev.h"
 #include "ui/events/ozone/evdev/touch_filter/shared_palm_detection_filter_state.h"
@@ -37,13 +41,52 @@ struct OpenInputDeviceParams {
   raw_ptr<SharedPalmDetectionFilterState> shared_palm_state;
 };
 
+// Asks the factory to close the device at `path` and open it again under
+// `id`, which is the only thing that re-arms the watch on it: the converter
+// stops watching a descriptor whose read failed, and
+// `InputDeviceFactoryEvdev::AttachInputDevice` is the only caller of
+// `EventConverterEvdev::Start()`.
+using ReopenInputDeviceCall =
+    base::RepeatingCallback<void(int id, const base::FilePath& path)>;
+
 class COMPONENT_EXPORT(EVDEV) InputDeviceOpener {
  public:
-  virtual ~InputDeviceOpener() = default;
+  // Out of line, both of them, because `reopen_device_` makes this a class
+  // the chromium-style plugin calls complex -- a single templated non-trivial
+  // member is its whole threshold -- and it then requires an out-of-line
+  // constructor AND destructor. It was an empty interface before that member
+  // and an inlined `= default` pair was fine.
+  InputDeviceOpener();
+  virtual ~InputDeviceOpener();
 
   virtual std::unique_ptr<EventConverterEvdev> OpenInputDevice(
       const OpenInputDeviceParams& params) = 0;
+
+  // Handed over by the factory that owns this opener, once that factory
+  // exists -- an opener is constructed in order to be given to the factory, so
+  // it cannot take the factory as an argument.
+  //
+  // An opener that `open`s its own descriptors never needs it: nothing takes
+  // those away. One whose descriptors are lent to it -- Domicile's, from
+  // logind, which revokes them on a console switch -- has no other way back.
+  void SetDeviceReopener(ReopenInputDeviceCall reopen);
+
+ protected:
+  const ReopenInputDeviceCall& reopen_device() const { return reopen_device_; }
+
+ private:
+  ReopenInputDeviceCall reopen_device_;
 };
+
+// How an ozone platform says which opener its evdev thread should use.
+//
+// A FACTORY RATHER THAN AN INSTANCE, because the opener is used on the evdev
+// thread and only there, and one of them -- the DRM platform's, which takes
+// its descriptors from logind over D-Bus -- owns a connection whose origin
+// thread is the thread that created it. Making it here would make the wrong
+// thread the owner.
+using InputDeviceOpenerFactory =
+    base::OnceCallback<std::unique_ptr<InputDeviceOpener>()>;
 }  // namespace ui
 
 #endif  // UI_EVENTS_OZONE_EVDEV_INPUT_DEVICE_OPENER_H_
diff --git a/ui/events/ozone/evdev/input_device_opener_evdev.cc b/ui/events/ozone/evdev/input_device_opener_evdev.cc
index 1a7e671b..e9b64c7d 100644
--- a/ui/events/ozone/evdev/input_device_opener_evdev.cc
+++ b/ui/events/ozone/evdev/input_device_opener_evdev.cc
@@ -7,10 +7,12 @@
 #include <fcntl.h>
 
 #include <memory>
+#include <utility>
 
 #include "base/command_line.h"
 #include "base/files/file_path.h"
 #include "base/files/scoped_file.h"
+#include "base/functional/bind.h"
 #include "base/logging.h"
 #include "base/memory/ptr_util.h"
 #include "base/trace_event/trace_event.h"
@@ -110,7 +112,7 @@ std::unique_ptr<EventConverterEvdev> InputDeviceOpenerEvdev::OpenInputDevice(
   const base::FilePath& path = params.path;
   TRACE_EVENT1("evdev", "OpenInputDevice", "path", path.value());
 
-  base::ScopedFD fd(open(path.value().c_str(), O_RDWR | O_NONBLOCK));
+  base::ScopedFD fd = OpenDeviceFd(params);
   if (fd.get() < 0) {
     PLOG(ERROR) << "Cannot open " << path.value();
     return nullptr;
@@ -132,4 +134,16 @@ std::unique_ptr<EventConverterEvdev> InputDeviceOpenerEvdev::OpenInputDevice(
   return CreateConverter(params, std::move(fd), devinfo);
 }
 
+base::ScopedFD InputDeviceOpenerEvdev::OpenDeviceFd(
+    const OpenInputDeviceParams& params) {
+  return base::ScopedFD(
+      open(params.path.value().c_str(), O_RDWR | O_NONBLOCK));
+}
+
+InputDeviceOpenerFactory OpenInputDevicesDirectly() {
+  return base::BindOnce([]() -> std::unique_ptr<InputDeviceOpener> {
+    return std::make_unique<InputDeviceOpenerEvdev>();
+  });
+}
+
 }  // namespace ui
diff --git a/ui/events/ozone/evdev/input_device_opener_evdev.h b/ui/events/ozone/evdev/input_device_opener_evdev.h
index 7a89eae7..4afe766c 100644
--- a/ui/events/ozone/evdev/input_device_opener_evdev.h
+++ b/ui/events/ozone/evdev/input_device_opener_evdev.h
@@ -24,7 +24,26 @@ class COMPONENT_EXPORT(EVDEV) InputDeviceOpenerEvdev
 
   std::unique_ptr<EventConverterEvdev> OpenInputDevice(
       const OpenInputDeviceParams& params) override;
+
+ protected:
+  // The descriptor for `params.path`, and the ONE thing a platform whose
+  // descriptors do not come from an `open` has to replace. It is given the
+  // whole of `params` rather than the path because a platform that has to
+  // reopen a device later needs the id the factory knows it by. Everything
+  // else this class does
+  // -- the monotonic clock, `EventDeviceInfo` and the choice of converter --
+  // is the same whoever opened the node.
+  //
+  // It is a seam because on an ordinary Linux desktop the `open` below fails:
+  // logind's `70-uaccess.rules` ACLs `drm card*` and `renderD*` and, among
+  // input devices, only `ID_INPUT_JOYSTICK`, so a keyboard keeps its
+  // group-owned mode and the session user gets nothing on it. See
+  // `ui/ozone/platform/drm/domicile/drm_logind_input.h`.
+  virtual base::ScopedFD OpenDeviceFd(const OpenInputDeviceParams& params);
 };
+
+// The opener every platform but Domicile's DRM one wants.
+COMPONENT_EXPORT(EVDEV) InputDeviceOpenerFactory OpenInputDevicesDirectly();
 }  // namespace ui
 
 #endif  // UI_EVENTS_OZONE_EVDEV_INPUT_DEVICE_OPENER_EVDEV_H_
