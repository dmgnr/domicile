 #include "base/functional/callback.h"
 #include "ui/events/ozone/evdev/input_controller_evdev.h"
+#include "ui/events/ozone/evdev/input_device_opener.h"
 
 namespace base {
 class Thread;
@@ -36,10 +37,14 @@ class EventThreadEvdev {
   // Start a new events thread. All device events will get sent to the
   // passed dispatcher. The thread will call directly into cursor, so it
   // must be synchronized accordingly.
+  // `opener_factory` is run ON THE NEW THREAD, because the opener it builds
+  // is used there and one of them owns a D-Bus connection whose origin is the
+  // thread that created it.
   void Start(std::unique_ptr<DeviceEventDispatcherEvdev> dispatcher,
              CursorDelegateEvdev* cursor,
              EventThreadStartCallback callback,
-             InputControllerEvdev* input_controller);
+             InputControllerEvdev* input_controller,
+             InputDeviceOpenerFactory opener_factory);
 
