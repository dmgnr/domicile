From 184c022553c96fae4784055062e29f0898dde32b Mon Sep 17 00:00:00 2001
From: Domicile Thorium POC <domicile-thorium-poc@invalid.example>
Date: Sat, 14 Nov 2026 18:01:00 +0700
Subject: [PATCH] domicile: debounce transient webview visibility

---
 .../renderer/core/frame/remote_frame_view.cc  | 64 ++++++++++++++++++-
 .../renderer/core/frame/remote_frame_view.h   | 15 +++++
 2 files changed, 78 insertions(+), 1 deletion(-)

diff --git a/third_party/blink/renderer/core/frame/remote_frame_view.cc b/third_party/blink/renderer/core/frame/remote_frame_view.cc
index a6ee2a42..9723366b 100644
--- a/third_party/blink/renderer/core/frame/remote_frame_view.cc
+++ b/third_party/blink/renderer/core/frame/remote_frame_view.cc
@@ -8,6 +8,7 @@
 
 #include "base/feature_list.h"
 #include "base/metrics/histogram_macros.h"
+#include "base/notreached.h"
 #include "base/trace_event/trace_event.h"
 #include "components/paint_preview/common/paint_preview_tracker.h"
 #include "printing/buildflags/buildflags.h"
@@ -29,6 +30,8 @@
 #include "third_party/blink/renderer/platform/graphics/paint/cull_rect.h"
 #include "third_party/blink/renderer/platform/graphics/paint/drawing_recorder.h"
 #include "third_party/blink/renderer/platform/graphics/paint/foreign_layer_display_item.h"
+#include "third_party/blink/renderer/platform/scheduler/public/agent_group_scheduler.h"
+#include "third_party/blink/renderer/platform/scheduler/public/page_scheduler.h"
 #include "third_party/blink/renderer/platform/widget/frame_widget.h"
 #include "ui/gfx/geometry/rect.h"
 #include "ui/gfx/geometry/transform_util.h"
@@ -44,8 +47,39 @@ namespace blink {
 BASE_FEATURE(kSkipUnnecessaryRemoteFrameGeometryPropagation,
              base::FEATURE_ENABLED_BY_DEFAULT);
 
+namespace {
+
+// Domicile: how long a <webview>'s frame must stay less shown before its page
+// hears it. Longer than one lifecycle update, short enough that a hidden
+// window's page throttles at once to a person.
+constexpr base::TimeDelta kWebViewHideDelay = base::Milliseconds(100);
+
+// Domicile: how much of its page a frame shows, by the page visibility each
+// state gives a <webview>'s page: hidden, occluded or visible.
+int AmountShown(mojom::blink::FrameVisibility visibility) {
+  switch (visibility) {
+    case mojom::blink::FrameVisibility::kNotRendered:
+      return 0;
+    case mojom::blink::FrameVisibility::kRenderedOutOfViewport:
+      return 1;
+    case mojom::blink::FrameVisibility::kRenderedInViewport:
+      return 2;
+  }
+  NOTREACHED();
+}
+
+}  // namespace
+
 RemoteFrameView::RemoteFrameView(RemoteFrame* remote_frame)
-    : FrameView(gfx::Rect()), remote_frame_(remote_frame) {
+    : FrameView(gfx::Rect()),
+      remote_frame_(remote_frame),
+      held_visibility_(mojom::blink::FrameVisibility::kRenderedInViewport),
+      held_visibility_timer_(remote_frame->GetPage()
+                                 ->GetPageScheduler()
+                                 ->GetAgentGroupScheduler()
+                                 .DefaultTaskRunner(),
+                             this,
+                             &RemoteFrameView::SendHeldVisibility) {
   DCHECK(remote_frame);
   Show();
 }
@@ -319,6 +353,7 @@ void RemoteFrameView::UpdateCompositingScaleFactor() {
 }
 
 void RemoteFrameView::Dispose() {
+  held_visibility_timer_.Stop();
   HTMLFrameOwnerElement* owner_element = remote_frame_->DeprecatedLocalOwner();
   // ownerElement can be null during frame swaps, because the
   // RemoteFrameView is disconnected before detachment.
@@ -477,9 +512,35 @@ void RemoteFrameView::VisibilityForThrottlingChanged() {
 
 void RemoteFrameView::VisibilityChanged(
     blink::mojom::FrameVisibility visibility) {
+  // Domicile: hold a <webview>'s step toward hidden; see `held_visibility_`.
+  // The browser starts from in viewport (CrossProcessFrameConnector).
+  const blink::mojom::FrameVisibility sent = sent_visibility_.value_or(
+      blink::mojom::FrameVisibility::kRenderedInViewport);
+  if (IsA<HTMLWebViewElement>(remote_frame_->DeprecatedLocalOwner()) &&
+      AmountShown(visibility) < AmountShown(sent)) {
+    held_visibility_ = visibility;
+    if (!held_visibility_timer_.IsActive()) {
+      held_visibility_timer_.StartOneShot(kWebViewHideDelay, FROM_HERE);
+    }
+    return;
+  }
+  held_visibility_timer_.Stop();
+  SendVisibility(visibility);
+}
+
+void RemoteFrameView::SendVisibility(
+    blink::mojom::FrameVisibility visibility) {
+  if (sent_visibility_ == visibility) {
+    return;
+  }
+  sent_visibility_ = visibility;
   remote_frame_->GetRemoteFrameHostRemote().VisibilityChanged(visibility);
 }
 
+void RemoteFrameView::SendHeldVisibility(TimerBase*) {
+  SendVisibility(held_visibility_);
+}
+
 bool RemoteFrameView::CanThrottleRendering() const {
   return IsHiddenForThrottling() || IsSubtreeThrottled() || IsDisplayLocked();
 }
@@ -545,6 +606,7 @@ uint32_t RemoteFrameView::CapturePaintPreview(const gfx::Rect& rect,
 
 void RemoteFrameView::Trace(Visitor* visitor) const {
   visitor->Trace(remote_frame_);
+  visitor->Trace(held_visibility_timer_);
 }
 
 mojom::blink::WebFeature RemoteFrameView::SvgFilterPaintedCounter() const {
diff --git a/third_party/blink/renderer/core/frame/remote_frame_view.h b/third_party/blink/renderer/core/frame/remote_frame_view.h
index 755968ea..dbcd6ee3 100644
--- a/third_party/blink/renderer/core/frame/remote_frame_view.h
+++ b/third_party/blink/renderer/core/frame/remote_frame_view.h
@@ -18,6 +18,7 @@
 #include "third_party/blink/renderer/core/paint/paint_flags.h"
 #include "third_party/blink/renderer/platform/heap/garbage_collected.h"
 #include "third_party/blink/renderer/platform/heap/member.h"
+#include "third_party/blink/renderer/platform/timer.h"
 #include "ui/gfx/geometry/rect.h"
 
 namespace cc {
@@ -118,6 +119,10 @@ class CORE_EXPORT RemoteFrameView final
   // animations.
   gfx::Rect ComputeCompositingRect() const;
 
+  // Domicile: sends `visibility` to the browser unless it already has it.
+  void SendVisibility(blink::mojom::FrameVisibility visibility);
+  void SendHeldVisibility(TimerBase*);
+
   // Fetch the frozen size, if any, from the associated LayoutObject.
   void UpdateFrozenSize();
 
@@ -133,6 +138,16 @@ class CORE_EXPORT RemoteFrameView final
 
   std::optional<NaturalSizingInfo> natural_sizing_info_;
   bool needs_occlusion_tracking_ = false;
+
+  // Domicile: a <webview>'s page is hidden while its frame is not rendered or
+  // is out of the viewport
+  // (WebContentsImpl::OnRenderFrameProxyVisibilityChanged).
+  // A frame on its way into the viewport passes through both in one lifecycle
+  // update, so a shown page would blink hidden. A step that shows less is held
+  // for `kWebViewHideDelay` and dropped if the frame is shown again first.
+  std::optional<blink::mojom::FrameVisibility> sent_visibility_;
+  blink::mojom::FrameVisibility held_visibility_;
+  HeapTaskRunnerTimer<RemoteFrameView> held_visibility_timer_;
 };
 
 template <>
