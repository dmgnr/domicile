From e6ddc624f69ec03f9c11dbf6a59d96dfb957cfcb Mon Sep 17 00:00:00 2001
From: Domicile Thorium POC <domicile-thorium-poc@invalid.example>
Date: Sat, 14 Nov 2026 16:31:08 +0700
Subject: [PATCH] domicile: wait for desktop notification server on Chromium
 156

---
 .../notification_platform_bridge_linux.cc     | 38 +++++++++++++++++--
 1 file changed, 35 insertions(+), 3 deletions(-)

diff --git a/chrome/browser/notifications/notification_platform_bridge_linux.cc b/chrome/browser/notifications/notification_platform_bridge_linux.cc
index 98400121..e4ef0a69 100644
--- a/chrome/browser/notifications/notification_platform_bridge_linux.cc
+++ b/chrome/browser/notifications/notification_platform_bridge_linux.cc
@@ -49,6 +49,7 @@
 #include "base/task/thread_pool.h"
 #include "base/threading/sequence_bound.h"
 #include "base/time/time.h"
+#include "base/timer/timer.h"
 #include "base/types/expected.h"
 #include "base/version.h"
 #include "chrome/browser/browser_process.h"
@@ -94,6 +95,11 @@ BASE_FEATURE(kWebNotificationPortalFallback,
 const char kFreedesktopNotificationsName[] = "org.freedesktop.Notifications";
 const char kFreedesktopNotificationsPath[] = "/org/freedesktop/Notifications";
 
+// Domicile's engine fork: how long Init() waits for a server to take
+// kFreedesktopNotificationsName before looking for one to start or falling
+// back.
+constexpr base::TimeDelta kServerWait = base::Seconds(20);
+
 // DBus name / path / interface for portal notifications.
 const char kPortalDesktopName[] = "org.freedesktop.portal.Desktop";
 const char kPortalDesktopPath[] = "/org/freedesktop/portal/desktop";
@@ -437,12 +443,20 @@ class NotificationPlatformBridgeLinuxImpl : public NotificationPlatformBridge {
   }
 
   // Sets up the D-Bus connection.
+  //
+  // Domicile's engine fork: wait briefly for the compositor's notification
+  // server before Chrome looks for one to start or falls back to the portal.
   void Init() {
     DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
-    dbus_utils::CheckForServiceAndStart(
-        bus_, kFreedesktopNotificationsName,
-        base::BindOnce(&NotificationPlatformBridgeLinuxImpl::OnServiceStarted,
+    server_wait_.Start(
+        FROM_HERE, kServerWait,
+        base::BindOnce(&NotificationPlatformBridgeLinuxImpl::CheckForServer,
                        weak_factory_.GetWeakPtr()));
+    bus_->GetObjectProxy(kFreedesktopNotificationsName,
+                         dbus::ObjectPath(kFreedesktopNotificationsPath))
+        ->WaitForServiceToBeAvailable(base::IgnoreArgs<bool>(base::BindOnce(
+            &NotificationPlatformBridgeLinuxImpl::CheckForServer,
+            weak_factory_.GetWeakPtr())));
   }
 
   // Makes the "Notify" call to D-Bus.
@@ -635,6 +649,19 @@ class NotificationPlatformBridgeLinuxImpl : public NotificationPlatformBridge {
     CleanUp();
   }
 
+  // The server arriving and the timeout race to start Chrome's lookup once.
+  void CheckForServer() {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    if (std::exchange(checked_for_server_, true)) {
+      return;
+    }
+    server_wait_.Stop();
+    dbus_utils::CheckForServiceAndStart(
+        bus_, kFreedesktopNotificationsName,
+        base::BindOnce(&NotificationPlatformBridgeLinuxImpl::OnServiceStarted,
+                       weak_factory_.GetWeakPtr()));
+  }
+
   void OnServiceStarted(std::optional<bool> service_started) {
     DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
     if (!service_started.value_or(false)) {
@@ -1634,6 +1661,11 @@ class NotificationPlatformBridgeLinuxImpl : public NotificationPlatformBridge {
   scoped_refptr<dbus::Bus> bus_;
   raw_ptr<dbus::ObjectProxy> notification_proxy_ = nullptr;
 
+  // Domicile's engine fork: Init()'s wait for a server, and whether it has
+  // ended.
+  base::OneShotTimer server_wait_;
+  bool checked_for_server_ = false;
+
   std::unordered_set<std::string> capabilities_;
 
   std::string server_name_;
-- 
2.56.0

